format=kestrel-program 1
name=Funeral Organ Bass
category=Dark Bass
author=Kestrel factory
description=Pedal-organ bass: the DWGS Organ4 approximation an octave down, steady sustain and a short release. For slow chord roots.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=DWGS
t1.osc1.dwgs=43
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=30
t1.amp.level=120
fx.mod.type=Flanger/Chorus
fx.mod.speed=70
fx.mod.depth=24
