format=kestrel-program 1
name=Warehouse Organ Bass
category=Deep House Bass
author=Kestrel factory
description=Short organ-type bass (DWGS Organ4 approximation + sine sub one octave down) with a quick filter blip.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.aeg.reset=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=43
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=100
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=20
t1.filter.egInt=20
t1.filter.keyTrack=40
t1.feg.attack=0
t1.feg.decay=36
t1.feg.sustain=0
t1.feg.release=20
t1.aeg.attack=0
t1.aeg.decay=52
t1.aeg.sustain=40
t1.aeg.release=18
t1.amp.level=120
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.eq.lowFreq=100Hz
fx.eq.lowGain=2
