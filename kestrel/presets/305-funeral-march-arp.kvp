format=kestrel-program 1
name=Funeral March Arp
category=Dark Arp
author=Kestrel factory
description=Slow Down arpeggio in eighths at 70 BPM on a church organ (DWGS Organ1 approximation plus 16-foot square), long gate. A procession.
arp.on=On
arp.type=Down
arp.range=1
arp.resolution=1/8
arp.gate=90
arp.tempo=70
arp.keySync=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=40
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=40
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=30
t1.amp.level=120
fx.mod.type=Flanger/Chorus
fx.mod.speed=80
fx.mod.depth=36
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=20
