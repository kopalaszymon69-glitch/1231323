format=kestrel-program 1
name=Static Storm
category=Dark FX
author=Kestrel factory
description=Crackling interference: LFO1 sample & hold at about 13 Hz throws the noise level around in random bursts, band-passed and bounced left and right.
t1.mixer.osc1=0
t1.mixer.noise=20
t1.filter.type=-12dB BPF
t1.filter.cutoff=86
t1.filter.resonance=20
t1.aeg.attack=10
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=60
t1.lfo1.wave=S&H
t1.lfo1.freq=102
t1.patch1.src=LFO1
t1.patch1.dst=Noise Level
t1.patch1.int=63
t1.lfo2.wave=S&H
t1.lfo2.freq=60
t1.patch2.src=LFO2
t1.patch2.dst=Cutoff
t1.patch2.int=4
t1.amp.level=127
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=34
fx.mod.type=Phaser
fx.mod.speed=60
fx.mod.depth=30
