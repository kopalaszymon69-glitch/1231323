format=kestrel-program 1
name=Midnight Fingers
category=Dark Bass
author=Kestrel factory
description=Fingered electric bass: a lightly folded triangle with a quiet saw, a soft pluck in the filter and a steady sustain. Velocity on level and tone.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.osc1.wave=Triangle
t1.osc1.ctrl1=20
t1.osc2.wave=Saw
t1.mixer.osc1=127
t1.mixer.osc2=40
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.filter.velSense=14
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=20
t1.aeg.attack=0
t1.aeg.decay=84
t1.aeg.sustain=80
t1.aeg.release=20
t1.amp.velSense=30
t1.amp.level=127
