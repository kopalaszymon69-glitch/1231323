format=kestrel-program 1
name=Wilted Rose
category=Sad Pluck
author=Kestrel factory
description=The two-phase saw's octave content follows the amp envelope (patch to CONTROL 1), so each note blooms an octave-bright edge that wilts as it fades.
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.resonance=16
t1.filter.keyTrack=30
t1.aeg.attack=0
t1.aeg.decay=74
t1.aeg.sustain=0
t1.aeg.release=60
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=30
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=30
