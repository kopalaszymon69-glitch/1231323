format=kestrel-program 1
name=Clockwork Grief
category=Dark Arp
author=Kestrel factory
description=Mechanical Alt1 arpeggio in swung sixteenths: a hollow square pluck with a snappy filter. Ticks along like a sad automaton.
arp.on=On
arp.type=Alt1
arp.range=1
arp.resolution=1/16
arp.gate=40
arp.swing=20
arp.tempo=96
arp.keySync=On
t1.osc1.wave=Square
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=30
t1.filter.egInt=16
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=24
