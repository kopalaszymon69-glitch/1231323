format=kestrel-program 1
name=Undertaker
category=Dark Bass
author=Kestrel factory
description=Solid synth bass from the DWGS SynBass1 approximation with a square sub, a dark 24 dB filter and gentle distortion.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=DWGS
t1.osc1.dwgs=8
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=50
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.keyTrack=30
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.distortion=On
t1.amp.level=120
