format=kestrel-program 1
name=Black Velvet Lead
category=Dark Lead
author=Kestrel factory
description=Thick legato lead: two saws 13 cents apart, a resonant 24 dB filter, single trigger with glide so slurred notes stay smooth. Chorus and quarter echo.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=66
t1.filter.resonance=30
t1.filter.keyTrack=30
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=40
t1.lfo2.freq=85
t1.amp.level=90
fx.mod.type=Flanger/Chorus
fx.mod.speed=52
fx.mod.depth=36
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=28
