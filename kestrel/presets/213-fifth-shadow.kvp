format=kestrel-program 1
name=Fifth Shadow
category=Sad Pluck
author=Kestrel factory
description=Dark power pluck: a square with a square a fourth below (a fifth an octave down) for a heavy, hollow shadow; closing 24 dB filter.
t1.osc1.wave=Square
t1.osc2.wave=Square
t1.osc2.semitone=-5
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=20
t1.filter.egInt=16
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=54
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=0
t1.aeg.release=50
t1.amp.velSense=30
t1.amp.level=110
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=26
