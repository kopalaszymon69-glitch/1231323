format=kestrel-program 1
name=Frozen Violins
category=Dark Strings & Choir
author=Kestrel factory
description=High, thin strings: saw plus a slightly flat saw an octave up through a 12 dB high-pass that strips the body. Slow attack, ensemble, long cross delay. Play above middle C.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.osc2.tune=-3
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-12dB HPF
t1.filter.cutoff=46
t1.filter.keyTrack=24
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.pitch.vibratoInt=6
t1.lfo2.freq=88
t1.amp.level=56
fx.mod.type=Ensemble
fx.mod.speed=64
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.time=108
fx.delay.depth=36
fx.eq.hiFreq=7.00kHz
fx.eq.hiGain=-5
