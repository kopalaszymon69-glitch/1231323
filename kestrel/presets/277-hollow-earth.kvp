format=kestrel-program 1
name=Hollow Earth
category=Dark Drone
author=Kestrel factory
description=Evolving FM drone: LFO1 (about 10 s per cycle) moves a deep cross-modulation of a sine by OSC2 an octave up, so the tone slowly hardens and softens.
t1.osc1.wave=Sine
t1.osc1.ctrl1=60
t1.osc1.ctrl2=60
t1.lfo1.wave=Triangle
t1.lfo1.freq=14
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=24
t1.aeg.attack=84
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.amp.level=88
fx.mod.type=Ensemble
fx.mod.speed=36
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.time=108
fx.delay.depth=36
