format=kestrel-program 1
name=Thunder Far Away
category=Dark FX
author=Kestrel factory
description=Low, rolling rumble: noise through a low resonant 24 dB filter that sample & hold shakes, saturated by the distortion stage, with a slow swell and a long decay. Any key; lower keys are deeper.
t1.mixer.osc1=0
t1.mixer.noise=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.keyTrack=24
t1.aeg.attack=40
t1.aeg.decay=104
t1.aeg.sustain=0
t1.aeg.release=100
t1.lfo2.wave=S&H
t1.lfo2.freq=70
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=4
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=30
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=30
fx.eq.lowFreq=60Hz
fx.eq.lowGain=4
t1.amp.distortion=On
