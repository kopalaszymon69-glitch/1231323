format=kestrel-program 1
name=Dread Pulse
category=Dark Drone
author=Kestrel factory
description=Pulsing drone in tempo: LFO2 (unipolar square, one cycle per quarter note) gates the level of a dark saw drone, like a slow, ominous heartbeat machine.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.keyTrack=24
t1.aeg.attack=20
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=70
t1.lfo2.wave=Square2
t1.lfo2.tempoSync=On
t1.lfo2.syncNote=1/4
t1.lfo2.keySync=Timbre
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-55
t1.amp.level=110
fx.mod.type=Phaser
fx.mod.speed=26
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=26
