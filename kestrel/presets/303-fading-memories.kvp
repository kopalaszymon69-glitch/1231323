format=kestrel-program 1
name=Fading Memories
category=Dark Arp
author=Kestrel factory
description=Random eighth-note arpeggio with a lazy swing, played on a dark electric piano (DWGS E.Piano3 approximation) with tremolo and a long echo.
arp.on=On
arp.type=Random
arp.range=2
arp.resolution=1/8
arp.gate=80
arp.swing=30
arp.tempo=78
arp.keySync=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=38
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=90
t1.aeg.sustain=20
t1.aeg.release=56
t1.lfo2.wave=Sine
t1.lfo2.freq=82
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-6
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=56
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=34
