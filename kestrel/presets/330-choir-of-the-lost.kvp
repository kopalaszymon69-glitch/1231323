format=kestrel-program 1
name=Choir of the Lost
category=Dark Vocoder
author=Kestrel factory
description=Vocoder choir: a Vox-wave carrier with resonant bands, full ensemble and half-note cross echoes. Sing or speak into AUDIO IN 1 and play slow minor chords.
prog.voiceMode=Vocoder
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=50
t1.aeg.attack=24
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=76
voc.mixer.osc1=127
voc.mixer.noise=6
voc.filter.formantShift=0
voc.filter.resonance=40
voc.filter.efSense=40
voc.in1.threshold=10
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=90
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=34
