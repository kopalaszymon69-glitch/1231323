format=kestrel-program 1
name=Hollow Bones
category=Sad Pluck
author=Kestrel factory
description=Woody, knocking pluck: the triangle wavefold follows the amp envelope (patch to CONTROL 1), so each note starts folded and bright and decays to a pure tone.
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=54
t1.aeg.sustain=0
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=30
t1.amp.velSense=20
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=34
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=20
