format=kestrel-program 1
name=Whispering Walls
category=Dark Vocoder
author=Kestrel factory
description=Pure whisper: the carrier is noise only, so any voice becomes an unpitched, breathy whisper (any key, held). The vocoder distortion is on to lift the quiet noise bands; long cross delay, ensemble.
prog.voiceMode=Vocoder
t1.aeg.attack=10
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=70
voc.mixer.osc1=0
voc.mixer.noise=127
voc.filter.formantShift=0
voc.filter.resonance=0
voc.filter.efSense=30
voc.in1.threshold=6
voc.in1.hpfLevel=110
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=40
voc.amp.distortion=On
