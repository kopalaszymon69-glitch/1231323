format=kestrel-program 1
name=Ghost Train
category=Dark Arp
author=Kestrel factory
description=Fast, hypnotic sextuplets (1/24) of a short square tick through a slow phaser. One octave, Up; hold two or three notes and let it run.
arp.on=On
arp.type=Up
arp.range=1
arp.resolution=1/24
arp.gate=24
arp.tempo=90
arp.keySync=On
t1.osc1.wave=Square
t1.osc1.ctrl1=30
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=24
t1.filter.keyTrack=30
t1.aeg.attack=0
t1.aeg.decay=40
t1.aeg.sustain=0
t1.aeg.release=24
t1.amp.level=120
fx.mod.type=Phaser
fx.mod.speed=26
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=20
