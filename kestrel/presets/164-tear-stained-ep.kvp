format=kestrel-program 1
name=Tear-Stained EP
category=Melancholic Keys
author=Kestrel factory
description=FM-style electric piano: velocity drives the cross-modulation depth (patch to OSC1 Control 1), so soft notes are pure and hard notes ring metallic. Long decay.
t1.osc1.wave=Sine
t1.osc1.ctrl1=12
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=0
t1.aeg.decay=98
t1.aeg.sustain=16
t1.aeg.release=66
t1.amp.velSense=36
t1.patch1.src=Velocity
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=24
t1.amp.level=106
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=26
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=24
