format=kestrel-program 1
name=Shiver Pluck
category=Sad Pluck
author=Kestrel factory
description=Folded triangle into a resonant band-pass; fast sample & hold shivers on the cutoff.
t1.osc1.wave=Triangle
t1.osc1.ctrl1=60
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB BPF
t1.filter.cutoff=58
t1.filter.resonance=60
t1.filter.egInt=10
t1.filter.keyTrack=48
t1.feg.decay=50
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=60
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.level=90
t1.lfo2.wave=S&H
t1.lfo2.freq=80
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=2
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=40
t1.amp.velSense=30
