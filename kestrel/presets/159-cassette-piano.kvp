format=kestrel-program 1
name=Cassette Piano
category=Melancholic Keys
author=Kestrel factory
description=Lo-fi electric piano (DWGS E.Piano3 approximation) with tape wow (LFO2 on pitch at about 0.4 Hz), cut highs and a dotted echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=38
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.keyTrack=24
t1.filter.velSense=14
t1.aeg.attack=0
t1.aeg.decay=94
t1.aeg.sustain=24
t1.aeg.release=56
t1.amp.velSense=34
t1.lfo2.wave=Sine
t1.lfo2.freq=40
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3.5
t1.amp.level=116
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=24
fx.eq.hiFreq=4.00kHz
fx.eq.hiGain=-6
