format=kestrel-program 1
name=Subterranean
category=Dark Drone
author=Kestrel factory
description=Crushing low drone: unison squares spread 50 cents, a very low 24 dB filter and distortion. The beating of the unison voices makes it shudder.
t1.voice.assign=Unison
t1.voice.unisonDetune=50
t1.osc1.wave=Square
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=80
t1.amp.distortion=On
t1.amp.level=70
fx.mod.type=Phaser
fx.mod.speed=20
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=20
