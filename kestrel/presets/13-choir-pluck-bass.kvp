format=kestrel-program 1
name=Choir Pluck Bass
category=Angelcore Bass
author=Kestrel factory
description=Bouncy melodic pulse bass with a resonant filter pluck; velocity opens the filter. Retriggering mono.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.aeg.reset=Off
t1.osc1.wave=Square
t1.osc1.ctrl1=35
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=44
t1.filter.resonance=42
t1.filter.egInt=40
t1.filter.keyTrack=32
t1.feg.attack=0
t1.feg.decay=46
t1.feg.sustain=18
t1.feg.release=28
t1.aeg.attack=0
t1.aeg.decay=58
t1.aeg.sustain=70
t1.aeg.release=24
t1.amp.level=110
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=20
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=10
global.clock=Auto
