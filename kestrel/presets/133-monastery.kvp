format=kestrel-program 1
name=Monastery
category=Dark Strings & Choir
author=Kestrel factory
description=Low male choir an octave down: a darker Vox frame, a slight constant vibrato (LFO2 to pitch, about 5 Hz) and a resonant 24 dB low-pass. Ensemble.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=90
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=66
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=66
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=48
fx.mod.depth=80
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=26
