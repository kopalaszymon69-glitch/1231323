format=kestrel-program 1
name=Grave Arp
category=Darkwave Arp
author=Kestrel factory
description=Arpeggiated PWM pluck (Up, 2 octaves, 1/16) with a synced 3/16 delay; hold a minor chord.
arp.on=On
arp.type=Up
arp.range=2
arp.resolution=1/16
arp.gate=40
arp.tempo=118
arp.keySync=On
t1.voice.assign=Poly
t1.osc1.wave=Square
t1.osc1.ctrl1=50
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=46
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=50
t1.filter.type=-24dB LPF
t1.filter.cutoff=46
t1.filter.resonance=48
t1.filter.egInt=30
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=42
t1.feg.sustain=10
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=50
t1.aeg.release=30
t1.amp.level=115
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=52
