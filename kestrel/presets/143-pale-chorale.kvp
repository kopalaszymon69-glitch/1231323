format=kestrel-program 1
name=Pale Chorale
category=Dark Strings & Choir
author=Kestrel factory
description=Soft vocal chorale from the DWGS Voice2 approximation with a low saw an octave down for body; MOD wheel vibrato; ensemble.
t1.osc1.wave=DWGS
t1.osc1.dwgs=62
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=24
t1.aeg.attack=66
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.pitch.vibratoInt=8
t1.lfo2.freq=84
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=52
fx.mod.depth=80
fx.delay.type=Stereo Delay
fx.delay.time=94
fx.delay.depth=26
