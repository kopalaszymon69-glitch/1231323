format=kestrel-program 1
name=Sub Drone Bass
category=Dark Bass
author=Kestrel factory
description=Poly drone bass: a sine with a triangle an octave down, a slow swell and a long release, for held low notes and ballad roots.
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.aeg.attack=50
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=84
t1.amp.level=84
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=16
