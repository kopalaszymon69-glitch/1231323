format=kestrel-program 1
name=Cello Lament
category=Dark Strings & Choir
author=Kestrel factory
description=Low, bowed string: saw plus a saw an octave down, tracking 24 dB low-pass, velocity opens the filter. MOD wheel vibrato. Best below middle C.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.resonance=10
t1.filter.keyTrack=36
t1.filter.velSense=16
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=70
t1.amp.velSense=24
t1.pitch.vibratoInt=10
t1.lfo2.freq=84
t1.amp.level=90
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=80
fx.delay.depth=20
