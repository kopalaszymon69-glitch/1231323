format=kestrel-program 1
name=Mourners
category=Dark Strings & Choir
author=Kestrel factory
description=An "aah" choir built from a saw through a resonant band-pass that acts as a single formant, with a gentle constant vibrato. Ensemble and a long stereo echo.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-12dB BPF
t1.filter.cutoff=76
t1.filter.resonance=40
t1.filter.keyTrack=12
t1.aeg.attack=64
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=88
t1.lfo2.wave=Sine
t1.lfo2.freq=86
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3
t1.amp.level=66
fx.mod.type=Ensemble
fx.mod.speed=54
fx.mod.depth=90
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=30
