format=kestrel-program 1
name=Cinder
category=Dark Pad
author=Kestrel factory
description=Gritty, smouldering pad: detuned saws into the distortion stage after a dark resonant 24 dB low-pass. Slow attack, phaser.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=-5
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=30
t1.filter.keyTrack=24
t1.aeg.attack=64
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=88
t1.amp.distortion=On
t1.amp.level=100
fx.mod.type=Phaser
fx.mod.speed=38
fx.mod.depth=46
fx.delay.type=Stereo Delay
fx.delay.time=86
fx.delay.depth=26
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-4
