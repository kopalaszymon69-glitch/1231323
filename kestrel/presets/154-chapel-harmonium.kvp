format=kestrel-program 1
name=Chapel Harmonium
category=Melancholic Keys
author=Kestrel factory
description=Reedy pump organ: a 25 % pulse with a quiet saw an octave below, a short swell-in and a slight constant vibrato.
t1.osc1.wave=Square
t1.osc1.ctrl1=64
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=36
t1.filter.type=-12dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=24
t1.aeg.attack=24
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=50
t1.lfo2.wave=Sine
t1.lfo2.freq=82
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=2.5
t1.amp.level=56
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.time=86
fx.delay.depth=16
