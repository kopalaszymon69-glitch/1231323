format=kestrel-program 1
name=Coldwave Pulse
category=Dark Arp
author=Kestrel factory
description=Driving eighth-note Up arpeggio of a tight saw pluck; steps 4 and 8 are muted, so the pattern stumbles. Classic cold-wave sequence.
arp.on=On
arp.type=Up
arp.range=1
arp.resolution=1/8
arp.gate=60
arp.tempo=110
arp.keySync=On
arp.step4=Off
arp.step8=Off
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=10
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=30
t1.aeg.release=24
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=36
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=24
