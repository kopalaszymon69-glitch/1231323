format=kestrel-program 1
name=Lonely Square
category=Dark Lead
author=Kestrel factory
description=Hollow square-wave lead (50 % pulse, odd harmonics only) through a soft 12 dB filter. MOD wheel vibrato; quarter-note cross echoes.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.pitch.vibratoInt=10
t1.osc1.wave=Square
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.keyTrack=30
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=46
t1.lfo2.freq=85
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=34
