format=kestrel-program 1
name=Grief Glide
category=Dark Bass
author=Kestrel factory
description=Sliding sub bass: a sine and a quiet triangle an octave up with a long glide (about 0.15 s), for slow, mournful bass slides. Play legato.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=60
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=30
t1.filter.type=-24dB LPF
t1.filter.cutoff=80
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=30
t1.amp.level=127
