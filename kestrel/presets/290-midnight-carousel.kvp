format=kestrel-program 1
name=Midnight Carousel
category=Dark Arp
author=Kestrel factory
description=Slowly turning carousel: an Up arpeggio over two octaves in sixteenths of a dull bell (DWGS Bell2 approximation), with dotted cross echoes. Hold a minor chord.
arp.on=On
arp.type=Up
arp.range=2
arp.resolution=1/16
arp.gate=50
arp.tempo=88
arp.keySync=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=58
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.filter.keyTrack=20
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=40
