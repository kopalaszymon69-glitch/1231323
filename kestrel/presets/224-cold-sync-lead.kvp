format=kestrel-program 1
name=Cold Sync Lead
category=Dark Lead
author=Kestrel factory
description=Hard-sync lead whose overtone peak sweeps down at every note (filter EG to OSC2 Tune), behind a dark 24 dB filter. Mono with short glide.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.pitch.portamento=20
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=7
t1.mixer.osc1=20
t1.mixer.osc2=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=76
t1.filter.resonance=14
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=70
t1.feg.sustain=0
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=40
t1.patch1.src=Filter EG
t1.patch1.dst=OSC2 Tune
t1.patch1.int=36
t1.pitch.vibratoInt=8
t1.lfo2.freq=85
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=26
