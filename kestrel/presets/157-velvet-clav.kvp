format=kestrel-program 1
name=Velvet Clav
category=Melancholic Keys
author=Kestrel factory
description=Soft clavinet (DWGS Clav1 approximation) through a resonant 24 dB low-pass that velocity opens, giving a slow, sulky auto-wah. Phaser.
t1.osc1.wave=DWGS
t1.osc1.dwgs=47
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=66
t1.filter.resonance=30
t1.filter.egInt=8
t1.filter.keyTrack=30
t1.filter.velSense=24
t1.feg.attack=0
t1.feg.decay=64
t1.feg.sustain=20
t1.aeg.attack=0
t1.aeg.decay=80
t1.aeg.sustain=40
t1.aeg.release=40
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=42
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=18
