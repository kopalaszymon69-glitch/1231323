format=kestrel-program 1
name=Ghost Riser
category=Dark FX
author=Kestrel factory
description=Slow tension riser: over about four and a half seconds the filter opens and the pitch climbs two semitones, on noise and a saw. Hold one note into the drop.
t1.osc1.wave=Saw
t1.mixer.osc1=90
t1.mixer.noise=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=40
t1.filter.resonance=50
t1.filter.egInt=30
t1.filter.keyTrack=24
t1.feg.attack=110
t1.feg.decay=80
t1.feg.sustain=127
t1.feg.release=40
t1.aeg.attack=100
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=40
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=20
t1.amp.level=80
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=40
