format=kestrel-program 1
name=Widow's Veil
category=Dark Pad
author=Kestrel factory
description=Breathy veil: a sine with slight cross-modulation from OSC2 an octave and a fifth up, plus soft filtered noise that follows the keyboard. Very slow attack and release.
t1.osc1.wave=Sine
t1.osc1.ctrl1=20
t1.osc2.wave=Triangle
t1.osc2.semitone=19
t1.mixer.osc1=120
t1.mixer.osc2=0
t1.mixer.noise=24
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.resonance=20
t1.filter.keyTrack=36
t1.aeg.attack=90
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=104
t1.amp.level=86
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=80
fx.delay.type=Stereo Delay
fx.delay.time=110
fx.delay.depth=40
