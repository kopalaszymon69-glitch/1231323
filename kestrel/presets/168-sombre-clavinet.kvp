format=kestrel-program 1
name=Sombre Clavinet
category=Melancholic Keys
author=Kestrel factory
description=Muted clavinet (DWGS Clav2 approximation) with a slightly resonant low-pass, velocity on tone and an eighth-note echo. For slow, sulky funk-noir lines.
t1.osc1.wave=DWGS
t1.osc1.dwgs=48
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=84
t1.filter.resonance=12
t1.filter.keyTrack=30
t1.filter.velSense=20
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=20
t1.aeg.release=30
t1.amp.velSense=34
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=50
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=20
