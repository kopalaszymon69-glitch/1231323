format=kestrel-program 1
name=Mourning Reese
category=Dark Bass
author=Kestrel factory
description=Wide unison reese with a square sub; LFO2 slowly breathes the cutoff, light phaser.
t1.voice.assign=Unison
t1.voice.unisonDetune=24
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=34
t1.filter.keyTrack=24
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=30
t1.amp.level=84
t1.lfo2.wave=Sine
t1.lfo2.freq=18
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=4
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Phaser
fx.mod.speed=34
fx.mod.depth=30
