format=kestrel-program 1
name=Ether Bed
category=Dark Drone
author=Kestrel factory
description=Soft background bed: a triangle with a little noise, a 12 dB low-pass, full-depth ensemble and a long cross delay; about three seconds to fade in.
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=3
t1.mixer.osc1=120
t1.mixer.osc2=40
t1.mixer.noise=12
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.keyTrack=24
t1.aeg.attack=104
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=110
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.time=120
fx.delay.depth=46
