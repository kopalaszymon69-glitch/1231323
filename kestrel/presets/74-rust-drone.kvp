format=kestrel-program 1
name=Rust Drone
category=Dark Drone
author=Kestrel factory
description=Unison hard-sync drone: LFO1 slowly drags the synced overtones, light distortion, low-pass.
t1.voice.assign=Unison
t1.voice.unisonDetune=30
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=10
t1.mixer.osc1=60
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=24
t1.filter.keyTrack=12
t1.aeg.attack=50
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=80
t1.amp.distortion=On
t1.amp.level=64
t1.lfo1.wave=Triangle
t1.lfo1.freq=16
t1.patch1.src=LFO1
t1.patch1.dst=OSC2 Tune
t1.patch1.int=24
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=36
fx.mod.type=Phaser
fx.mod.depth=34
