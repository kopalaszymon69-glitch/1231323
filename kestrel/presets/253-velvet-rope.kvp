format=kestrel-program 1
name=Velvet Rope
category=Dark Bass
author=Kestrel factory
description=Round, warm bass from the DWGS Bass4 approximation with a triangle sub an octave down; soft 24 dB filter, slight glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=16
t1.osc1.wave=DWGS
t1.osc1.dwgs=55
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.keyTrack=30
t1.aeg.attack=1
t1.aeg.decay=70
t1.aeg.sustain=110
t1.aeg.release=24
t1.amp.level=120
