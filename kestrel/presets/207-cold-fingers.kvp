format=kestrel-program 1
name=Cold Fingers
category=Sad Pluck
author=Kestrel factory
description=Nylon-string-like pluck: a narrow pulse through a softly resonant 24 dB low-pass with a quick EG and a natural decay. Velocity on tone and level.
t1.osc1.wave=Square
t1.osc1.ctrl1=90
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=10
t1.filter.egInt=14
t1.filter.keyTrack=36
t1.filter.velSense=16
t1.feg.attack=0
t1.feg.decay=60
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=84
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.velSense=36
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=48
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=80
fx.delay.depth=18
