format=kestrel-program 1
name=Phantom Oboe
category=Dark Lead
author=Kestrel factory
description=Reedy double-reed lead: a narrow pulse through a resonant band-pass, a 30 ms attack and a small constant vibrato. Mournful in the middle register.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=16
t1.osc1.wave=Square
t1.osc1.ctrl1=100
t1.mixer.osc1=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=80
t1.filter.resonance=30
t1.filter.keyTrack=30
t1.aeg.attack=16
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=36
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.time=84
fx.delay.depth=22
