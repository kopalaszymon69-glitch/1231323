format=kestrel-program 1
name=Harpsichord of Ash
category=Melancholic Keys
author=Kestrel factory
description=Plucked harpsichord: a narrow pulse plus a saw an octave up, a fast filter decay and no sustain. For slow baroque minor progressions.
t1.osc1.wave=Square
t1.osc1.ctrl1=100
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.osc2.tune=2
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.egInt=10
t1.filter.keyTrack=36
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=0
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=84
t1.aeg.sustain=0
t1.aeg.release=34
t1.amp.velSense=20
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.time=80
fx.delay.depth=16
