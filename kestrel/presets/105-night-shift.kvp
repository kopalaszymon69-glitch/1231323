format=kestrel-program 1
name=Night Shift
category=Dark Pad
author=Kestrel factory
description=Coldwave pad: two saws 13 cents apart with a little noise. The filter blooms over a second, then settles darker. Lush chorus and dotted L/R echoes.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.mixer.noise=10
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=30
t1.filter.egInt=12
t1.filter.keyTrack=24
t1.feg.attack=70
t1.feg.decay=96
t1.feg.sustain=40
t1.feg.release=80
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=80
t1.amp.level=66
fx.mod.type=Flanger/Chorus
fx.mod.speed=44
fx.mod.depth=70
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=30
