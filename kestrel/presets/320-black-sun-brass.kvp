format=kestrel-program 1
name=Black Sun Brass
category=Dark Stab
author=Kestrel factory
description=Heavy, slightly overdriven brass: detuned saws with a sub, a brassy filter envelope and the distortion stage. For dramatic minor fanfares.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=10
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.feg.attack=16
t1.feg.decay=64
t1.feg.sustain=60
t1.feg.release=30
t1.aeg.attack=6
t1.aeg.decay=70
t1.aeg.sustain=110
t1.aeg.release=36
t1.amp.distortion=On
t1.amp.level=60
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=84
fx.delay.depth=16
