format=kestrel-program 1
name=Black Velvet Bass
category=Dark Bass
author=Kestrel factory
description=Round saw bass, low cutoff with a soft envelope bloom; mono retrigger.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=38
t1.filter.resonance=30
t1.filter.egInt=24
t1.filter.keyTrack=32
t1.feg.decay=56
t1.feg.sustain=20
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=110
t1.aeg.release=26
t1.amp.level=118
