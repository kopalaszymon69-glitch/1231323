format=kestrel-program 1
name=Spiral Down
category=Dark Arp
author=Kestrel factory
description=Four-octave Down arpeggio in sixteenths of a resonant saw; LFO1 slowly opens and closes the filter over about four bars, so the spiral brightens and sinks.
arp.on=On
arp.type=Down
arp.range=4
arp.resolution=1/16
arp.gate=50
arp.tempo=100
arp.keySync=On
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=50
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=40
t1.lfo1.wave=Triangle
t1.lfo1.freq=14
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=6
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=34
fx.mod.type=Phaser
fx.mod.speed=30
fx.mod.depth=30
