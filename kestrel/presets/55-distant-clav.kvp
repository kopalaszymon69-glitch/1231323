format=kestrel-program 1
name=Distant Clav
category=Melancholic Keys
author=Kestrel factory
description=DWGS Clav2 approximation through a narrow band-pass (far-away radio); dotted cross delay.
t1.osc1.wave=DWGS
t1.osc1.dwgs=48
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB BPF
t1.filter.cutoff=74
t1.filter.resonance=34
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=74
t1.aeg.sustain=0
t1.aeg.release=60
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=50
t1.amp.velSense=30
