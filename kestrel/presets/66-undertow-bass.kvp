format=kestrel-program 1
name=Undertow Bass
category=Dark Bass
author=Kestrel factory
description=Deep sine + triangle sub with gentle distortion and glide; for slow, heavy lines.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=100
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.keyTrack=48
t1.aeg.attack=2
t1.aeg.decay=80
t1.aeg.sustain=110
t1.aeg.release=40
t1.amp.distortion=On
t1.amp.level=90
fx.eq.lowFreq=60Hz
fx.eq.lowGain=2
