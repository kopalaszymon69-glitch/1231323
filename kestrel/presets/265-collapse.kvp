format=kestrel-program 1
name=Collapse
category=Dark Bass
author=Kestrel factory
description=Unison saw bass (16 cents spread) that starts open and collapses into a dark sub over about two seconds of held note.
t1.voice.assign=Unison
t1.voice.unisonDetune=16
t1.voice.trigger=Single
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=40
t1.filter.resonance=24
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=96
t1.feg.sustain=0
t1.feg.release=20
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=30
t1.amp.level=100
