format=kestrel-program 1
name=Rusted Gamelan
category=Dark Bells
author=Kestrel factory
description=Clangy metallophone: a triangle ring-modulated by a square a fifth up. The sum and difference tones sit on the series an octave below the key, so it stays in key but sounds hollow and gong-like. Band-pass, medium decay.
t1.osc1.wave=Triangle
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=7
t1.mixer.osc1=100
t1.mixer.osc2=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=88
t1.filter.resonance=10
t1.filter.keyTrack=36
t1.aeg.attack=0
t1.aeg.decay=86
t1.aeg.sustain=0
t1.aeg.release=70
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=24
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=30
