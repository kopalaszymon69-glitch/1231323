format=kestrel-program 1
name=Hex Bells
category=Darkwave Keys
author=Kestrel factory
description=Ring-modulated square bells (OSC2 two octaves up, detuned) - the manual's bell recipe, darkened, with ping-pong delay.
t1.voice.assign=Poly
t1.osc1.wave=Square
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=24
t1.osc2.tune=-21
t1.mixer.osc1=30
t1.mixer.osc2=120
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.filter.resonance=10
t1.filter.keyTrack=30
t1.aeg.attack=0
t1.aeg.decay=92
t1.aeg.sustain=0
t1.aeg.release=86
t1.amp.level=110
t1.patch1.src=Velocity
t1.patch1.dst=Amp
t1.patch1.int=30
t1.amp.level=44
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=55
fx.mod.type=Ensemble
fx.mod.depth=30
