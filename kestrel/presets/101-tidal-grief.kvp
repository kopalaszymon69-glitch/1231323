format=kestrel-program 1
name=Tidal Grief
category=Dark Pad
author=Kestrel factory
description=PWM pad that ebbs: LFO1 moves the pulse width, LFO2 (about 6 s per cycle) pulls the 12 dB low-pass up and down like a tide. Square sub an octave below.
t1.osc1.wave=Square
t1.osc1.ctrl1=24
t1.osc1.ctrl2=50
t1.lfo1.wave=Triangle
t1.lfo1.freq=44
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=44
t1.filter.type=-12dB LPF
t1.filter.cutoff=60
t1.filter.resonance=24
t1.filter.keyTrack=24
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=94
t1.lfo2.wave=Sine
t1.lfo2.freq=22
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=4
t1.amp.level=56
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=96
fx.delay.depth=34
