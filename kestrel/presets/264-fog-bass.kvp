format=kestrel-program 1
name=Fog Bass
category=Dark Bass
author=Kestrel factory
description=Soft, polyphonic triangle bass with a gentle 30 ms attack and a medium release, for ballads and slow chord roots. Light ensemble.
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.keyTrack=24
t1.aeg.attack=20
t1.aeg.decay=70
t1.aeg.sustain=120
t1.aeg.release=50
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=20
