format=kestrel-program 1
name=Sorrow Sync
category=Dark Lead
author=Kestrel factory
description=Hard-sync lead whose overtones sweep slowly with LFO1 (patch to OSC2 Tune); mono with glide, eighth echo.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=24
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=5
t1.mixer.osc1=30
t1.mixer.osc2=120
t1.filter.type=-24dB LPF
t1.filter.cutoff=82
t1.filter.resonance=16
t1.filter.keyTrack=24
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=40
t1.amp.level=96
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.patch1.src=LFO1
t1.patch1.dst=OSC2 Tune
t1.patch1.int=30
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=34
fx.mod.type=Flanger/Chorus
fx.mod.depth=14
fx.mod.speed=50
