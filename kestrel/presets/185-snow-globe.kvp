format=kestrel-program 1
name=Snow Globe
category=Dark Bells
author=Kestrel factory
description=Small, sad music box: a triangle with a faint triangle two octaves up, a quick plucked decay, a soft high cut and ping-pong eighths.
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=24
t1.mixer.osc1=127
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=0
t1.aeg.decay=78
t1.aeg.sustain=0
t1.aeg.release=64
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=16
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=40
fx.eq.hiFreq=7.00kHz
fx.eq.hiGain=-3
