format=kestrel-program 1
name=Deep Sub Pulse
category=Deep House Bass
author=Kestrel factory
description=Round 12 dB low-pass saw bass with a soft envelope pluck and key tracking; velocity adds bite.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-12dB LPF
t1.filter.cutoff=48
t1.filter.resonance=30
t1.filter.egInt=24
t1.filter.keyTrack=32
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=20
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=100
t1.aeg.release=22
t1.amp.level=118
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=18
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
