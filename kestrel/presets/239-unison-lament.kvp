format=kestrel-program 1
name=Unison Lament
category=Dark Lead
author=Kestrel factory
description=Wide, heavy unison saw lead (40 cents spread over all voices) with glide and a dark 24 dB filter. For slow, crushing melodies.
t1.voice.assign=Unison
t1.voice.unisonDetune=40
t1.voice.trigger=Single
t1.pitch.portamento=34
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=20
t1.filter.keyTrack=30
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=50
t1.lfo2.freq=84
t1.amp.level=66
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=24
