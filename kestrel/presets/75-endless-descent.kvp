format=kestrel-program 1
name=Endless Descent
category=Dark Drone
author=Kestrel factory
description=Shepard tone that seems to fall forever: the DWGS Endless approximation with a falling LFO1 saw on pitch spanning about one octave; the octave-spaced spectrum hides the wrap. The fall is slower mid-cycle (pitch-mod curve).
t1.osc1.wave=DWGS
t1.osc1.dwgs=35
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=40
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=70
t1.amp.level=96
t1.lfo1.wave=Saw
t1.lfo1.freq=10
t1.lfo1.keySync=Timbre
t1.patch1.src=LFO1
t1.patch1.dst=Pitch
t1.patch1.int=33.94
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.time=96
fx.delay.depth=44
fx.mod.type=Ensemble
fx.mod.depth=50
