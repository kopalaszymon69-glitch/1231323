format=kestrel-program 1
name=Choir of Machines
category=Dark Drone
author=Kestrel factory
description=Metallic choir drone: a Vox wave ring-modulated by a square a fifth up (the products sit on the series an octave below), with a slow vowel drift and phaser.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=50
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=20
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=7
t1.mixer.osc1=80
t1.mixer.osc2=110
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=24
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=26
fx.mod.depth=56
fx.delay.type=Cross Delay
fx.delay.time=104
fx.delay.depth=34
