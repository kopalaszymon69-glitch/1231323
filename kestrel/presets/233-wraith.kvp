format=kestrel-program 1
name=Wraith
category=Dark Lead
author=Kestrel factory
description=Vocal lead: Vox wave whose vowel drifts slowly (LFO1 on CONTROL 1), long glide, constant vibrato. A ghostly voice singing wordlessly.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=50
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=70
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.filter.keyTrack=24
t1.aeg.attack=20
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=56
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=4
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=36
