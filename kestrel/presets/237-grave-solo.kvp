format=kestrel-program 1
name=Grave Solo
category=Dark Lead
author=Kestrel factory
description=Baritone lead for low melodies: a saw plus a square an octave down, a resonant 24 dB filter with a short bloom and a little glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.egInt=10
t1.filter.keyTrack=36
t1.feg.attack=10
t1.feg.decay=70
t1.feg.sustain=40
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=40
t1.lfo2.freq=84
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=22
