format=kestrel-program 1
name=Velvet Chord Stab
category=Deep House Keys
author=Kestrel factory
description=Classic deep-house chord stab: saw + square through a low-pass pluck, chorus and a synced 1/8 echo.
t1.voice.assign=Poly
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=12
t1.osc2.tune=4
t1.mixer.osc1=115
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=36
t1.filter.egInt=26
t1.filter.keyTrack=20
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=8
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=62
t1.aeg.sustain=24
t1.aeg.release=44
t1.amp.level=110
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=14
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Flanger/Chorus
fx.mod.speed=14
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=34
fx.eq.lowFreq=200Hz
fx.eq.lowGain=-3
