format=kestrel-program 1
name=Sleet
category=Dark Pad
author=Kestrel factory
description=Pitched, resonant noise two octaves above the key over a quiet saw body; LFO2 slowly moves the noise filter (patch to OSC1 Control 1) like wind-driven sleet.
t1.osc1.wave=Noise
t1.osc1.ctrl1=48
t1.osc1.ctrl2=80
t1.osc2.wave=Saw
t1.mixer.osc1=110
t1.mixer.osc2=44
t1.filter.type=-24dB LPF
t1.filter.cutoff=82
t1.filter.keyTrack=24
t1.aeg.attack=84
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.lfo2.wave=Sine
t1.lfo2.freq=30
t1.patch1.src=LFO2
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=8
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=70
fx.delay.type=Cross Delay
fx.delay.time=104
fx.delay.depth=40
