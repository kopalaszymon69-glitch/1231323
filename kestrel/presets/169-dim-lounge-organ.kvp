format=kestrel-program 1
name=Dim Lounge Organ
category=Melancholic Keys
author=Kestrel factory
description=Smoky drawbar-style organ (DWGS Organ2 approximation) through a rotary-like chorus at about 1.3 Hz. Instant attack, short release.
t1.osc1.wave=DWGS
t1.osc1.dwgs=41
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=24
t1.amp.level=90
fx.mod.type=Flanger/Chorus
fx.mod.speed=80
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=70
fx.delay.depth=14
