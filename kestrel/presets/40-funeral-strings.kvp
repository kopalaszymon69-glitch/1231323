format=kestrel-program 1
name=Funeral Strings
category=Dark Strings & Choir
author=Kestrel factory
description=Slow funeral strings: two saws 8 cents apart (one with a two-phase shimmer) under a dark 24 dB low-pass with a slow filter swell and a gentle LFO2 sway. Ensemble and a quarter-note cross delay.
t1.voice.assign=Poly
t1.osc1.wave=Saw
t1.osc1.ctrl1=18
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.resonance=10
t1.filter.egInt=6
t1.filter.keyTrack=20
t1.feg.attack=84
t1.feg.decay=90
t1.feg.sustain=60
t1.feg.release=90
t1.aeg.attack=78
t1.aeg.decay=90
t1.aeg.sustain=110
t1.aeg.release=96
t1.amp.level=68
t1.lfo2.wave=Sine
t1.lfo2.freq=18
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=3
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=90
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=40
fx.eq.hiFreq=8.00kHz
fx.eq.hiGain=-4
