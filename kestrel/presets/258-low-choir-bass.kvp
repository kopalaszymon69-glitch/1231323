format=kestrel-program 1
name=Low Choir Bass
category=Dark Bass
author=Kestrel factory
description=Ghostly sung bass: Vox wave an octave down under a 24 dB low-pass, mono with a little glide and a slow swell.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=80
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.keyTrack=30
t1.aeg.attack=24
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=40
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=20
