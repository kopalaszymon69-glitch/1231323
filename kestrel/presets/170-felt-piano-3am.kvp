format=kestrel-program 1
name=Felt Piano 3 AM
category=Melancholic Keys
author=Kestrel factory
description=Felted, intimate piano: a triangle and a quiet saw an octave down, a very short bright filter "hammer" that falls to dark, long decay. Velocity on level and tone.
t1.osc1.wave=Triangle
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=127
t1.mixer.osc2=24
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.egInt=12
t1.filter.keyTrack=36
t1.filter.velSense=20
t1.feg.attack=0
t1.feg.decay=30
t1.feg.sustain=10
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=0
t1.aeg.release=60
t1.amp.velSense=44
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=18
fx.eq.hiFreq=5.00kHz
fx.eq.hiGain=-3
