format=kestrel-program 1
name=Night Bus Wurli
category=Melancholic Keys
author=Kestrel factory
description=Gritty electric piano (DWGS E.Piano4 approximation) pushed gently into the distortion stage after a dark low-pass; slow phaser. Velocity adds bite.
t1.osc1.wave=DWGS
t1.osc1.dwgs=39
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.aeg.attack=0
t1.aeg.decay=90
t1.aeg.sustain=30
t1.aeg.release=50
t1.amp.velSense=30
t1.amp.distortion=On
t1.amp.level=96
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=18
