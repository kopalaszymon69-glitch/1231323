format=kestrel-program 1
name=Requiem Layer
category=Dark Pad
author=Kestrel factory
description=Layer: VOX choir (timbre 1, left) with a DWGS Voice2 approximation an octave down (timbre 2, right). 2+2 voices in compatibility mode.
prog.voiceMode=Layer
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=50
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=118
t1.aeg.release=94
t1.amp.level=100
t1.amp.pan=-24
t2.osc1.wave=DWGS
t2.osc1.dwgs=62
t2.pitch.transpose=-12
t2.mixer.osc1=120
t2.mixer.osc2=0
t2.filter.type=-24dB LPF
t2.filter.cutoff=70
t2.aeg.attack=82
t2.aeg.decay=80
t2.aeg.sustain=118
t2.aeg.release=100
t2.amp.level=96
t2.amp.pan=24
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
t2.patch1.int=0
t2.patch2.int=0
t2.patch3.int=0
t2.patch4.int=0
fx.mod.type=Ensemble
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=42
