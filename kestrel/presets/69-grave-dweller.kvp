format=kestrel-program 1
name=Grave Dweller
category=Dark Bass
author=Kestrel factory
description=DWGS SynBass5 approximation with a square sub and a resonant 12 dB low-pass blip; mono retrigger.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=12
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-12dB LPF
t1.filter.cutoff=54
t1.filter.resonance=40
t1.filter.egInt=16
t1.filter.keyTrack=40
t1.feg.decay=50
t1.feg.sustain=10
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=90
t1.aeg.release=24
t1.amp.level=118
