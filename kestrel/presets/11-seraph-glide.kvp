format=kestrel-program 1
name=Seraph Glide
category=Angelcore Bass
author=Kestrel factory
description=Saturated 808-style sine with long glide and a pitch punch from the filter EG; cross-mod adds grit.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=80
t1.osc1.wave=Sine
t1.osc1.ctrl1=20
t1.osc2.wave=Triangle
t1.osc2.semitone=0
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-24dB LPF
t1.filter.cutoff=76
t1.filter.resonance=8
t1.filter.keyTrack=48
t1.feg.attack=0
t1.feg.decay=30
t1.feg.sustain=0
t1.feg.release=30
t1.aeg.attack=0
t1.aeg.decay=108
t1.aeg.sustain=0
t1.aeg.release=70
t1.amp.distortion=On
t1.amp.level=96
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=34
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.eq.lowFreq=80Hz
fx.eq.lowGain=2
