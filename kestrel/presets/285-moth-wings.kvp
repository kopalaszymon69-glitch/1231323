format=kestrel-program 1
name=Moth Wings
category=Dark Drone
author=Kestrel factory
description=Fluttering texture: LFO2 at about 12 Hz flutters the level of a folded triangle, while LFO1 slowly changes the fold. Soft and nervous.
t1.osc1.wave=Triangle
t1.osc1.ctrl1=40
t1.osc1.ctrl2=40
t1.lfo1.wave=Triangle
t1.lfo1.freq=22
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=24
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.lfo2.wave=Sine
t1.lfo2.freq=100
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-16
t1.amp.level=66
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=60
fx.delay.type=L/R Delay
fx.delay.time=94
fx.delay.depth=34
