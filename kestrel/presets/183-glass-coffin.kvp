format=kestrel-program 1
name=Glass Coffin
category=Dark Bells
author=Kestrel factory
description=Cold, high glass bell: a sine with a light, slightly inharmonic FM partial about four times the pitch, medium decay and long stereo echoes.
t1.osc1.wave=Sine
t1.osc1.ctrl1=36
t1.osc2.wave=Triangle
t1.osc2.semitone=24
t1.osc2.tune=5
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=110
t1.aeg.attack=0
t1.aeg.decay=90
t1.aeg.sustain=0
t1.aeg.release=86
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=16
t1.amp.velSense=30
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=38
fx.eq.hiFreq=9.00kHz
fx.eq.hiGain=-3
