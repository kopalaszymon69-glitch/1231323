format=kestrel-program 1
name=Grief Swell Stab
category=Dark Stab
author=Kestrel factory
description=Reverse-feeling swell: the level and filter rise over about half a second, then stop dead when you release. Play on the beat before the chord change.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=20
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=70
t1.feg.decay=64
t1.feg.sustain=127
t1.feg.release=4
t1.aeg.attack=70
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=6
t1.amp.level=64
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=20
