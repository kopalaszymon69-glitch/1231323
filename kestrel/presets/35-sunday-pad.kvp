format=kestrel-program 1
name=Sunday Pad
category=Deep House Pad
author=Kestrel factory
description=Slow PWM pad: LFO1 modulates the pulse width, OSC2 saw detuned, ensemble. Warm and wide.
t1.voice.assign=Poly
t1.osc1.wave=Square
t1.osc1.ctrl1=36
t1.osc1.ctrl2=52
t1.lfo1.wave=Triangle
t1.lfo1.freq=34
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=120
t1.mixer.osc2=70
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.resonance=14
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.feg.attack=70
t1.feg.decay=80
t1.feg.sustain=60
t1.feg.release=80
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=86
t1.amp.level=72
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Ensemble
fx.mod.speed=12
fx.mod.depth=70
fx.delay.depth=22
fx.delay.time=96
