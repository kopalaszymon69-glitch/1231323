format=kestrel-program 1
name=Last Waltz Organ
category=Melancholic Keys
author=Kestrel factory
description=Fairground organ past its prime: DWGS Organ6 approximation with a saw an octave up tuned a few cents flat, ensemble and a short echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=45
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.osc2.tune=-3
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=86
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=30
t1.amp.level=90
fx.mod.type=Ensemble
fx.mod.speed=62
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=16
