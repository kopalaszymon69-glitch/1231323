format=kestrel-program 1
name=Crypt Choir
category=Witch House Pad
author=Kestrel factory
description=Slow VOX-wave choir pad through a band-pass, ensemble and a long cross delay. LFO1 breathes the waveform.
t1.voice.assign=Poly
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=40
t1.osc1.ctrl2=20
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.osc2.wave=Saw
t1.osc2.semitone=0
t1.osc2.tune=3
t1.mixer.osc1=127
t1.mixer.osc2=60
t1.mixer.noise=6
t1.filter.type=-12dB BPF
t1.filter.cutoff=84
t1.filter.resonance=34
t1.filter.keyTrack=24
t1.aeg.attack=82
t1.aeg.decay=80
t1.aeg.sustain=110
t1.aeg.release=92
t1.amp.level=127
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=6
t1.lfo2.freq=24
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Ensemble
fx.mod.speed=18
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=48
fx.eq.lowFreq=120Hz
fx.eq.lowGain=-3
