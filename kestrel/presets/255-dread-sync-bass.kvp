format=kestrel-program 1
name=Dread Sync Bass
category=Dark Bass
author=Kestrel factory
description=Snarling sync bass: the filter EG sweeps the synced OSC2 down at every note, under a resonant 24 dB low-pass. Retriggers per note.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=5
t1.mixer.osc1=40
t1.mixer.osc2=120
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=24
t1.filter.egInt=8
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=56
t1.feg.sustain=10
t1.feg.release=20
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=110
t1.aeg.release=24
t1.patch1.src=Filter EG
t1.patch1.dst=OSC2 Tune
t1.patch1.int=34
t1.amp.level=110
