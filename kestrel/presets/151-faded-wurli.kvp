format=kestrel-program 1
name=Faded Wurli
category=Melancholic Keys
author=Kestrel factory
description=Reedy electric piano (DWGS E.Piano2 approximation) with a gentle amplitude tremolo at about 5 Hz, velocity-sensitive and darkened.
t1.osc1.wave=DWGS
t1.osc1.dwgs=37
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.aeg.attack=0
t1.aeg.decay=92
t1.aeg.sustain=30
t1.aeg.release=56
t1.amp.velSense=34
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-8
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=44
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=74
fx.delay.depth=18
