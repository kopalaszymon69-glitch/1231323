format=kestrel-program 1
name=Bleeding Vox
category=Dark Lead
author=Kestrel factory
description=Narrow VOX-wave lead in a resonant band-pass that sways on LFO2; mono glide, dotted cross delay.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=35
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=90
t1.mixer.osc1=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=80
t1.filter.resonance=30
t1.filter.keyTrack=30
t1.aeg.attack=8
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=44
t1.amp.level=127
t1.lfo2.wave=Sine
t1.lfo2.freq=40
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=4
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=40
