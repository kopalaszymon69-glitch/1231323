format=kestrel-program 1
name=Underworld Hymn
category=Dark Pad
author=Kestrel factory
description=Layer: a closed saw pad on the left (timbre 1) and a hollow square pad an octave down on the right (timbre 2). 2 + 2 voices in Compatibility mode; set Extended for full chords.
prog.voiceMode=Layer
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=94
t1.amp.level=66
t1.amp.pan=-30
t2.osc1.wave=Square
t2.pitch.transpose=-12
t2.mixer.osc1=120
t2.filter.type=-12dB LPF
t2.filter.cutoff=62
t2.filter.keyTrack=24
t2.aeg.attack=84
t2.aeg.decay=80
t2.aeg.sustain=120
t2.aeg.release=100
t2.amp.level=70
t2.amp.pan=30
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=32
