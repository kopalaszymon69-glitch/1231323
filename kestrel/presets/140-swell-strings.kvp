format=kestrel-program 1
name=Swell Strings
category=Dark Strings & Choir
author=Kestrel factory
description=Slow crescendo strings: the filter EG takes about two seconds to open and holds, so long notes swell from dark to full. Ensemble, quarter-note echo.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=-4
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=46
t1.filter.resonance=12
t1.filter.egInt=14
t1.filter.keyTrack=24
t1.feg.attack=94
t1.feg.decay=90
t1.feg.sustain=127
t1.feg.release=90
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.amp.level=60
fx.mod.type=Ensemble
fx.mod.speed=60
fx.mod.depth=100
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=24
