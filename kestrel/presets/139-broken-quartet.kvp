format=kestrel-program 1
name=Broken Quartet
category=Dark Strings & Choir
author=Kestrel factory
description=Strings played by tired hands: each voice gets its own slow random pitch drift of a few cents (LFO1 sample & hold, key-synced per voice), so chords never quite settle.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.keyTrack=24
t1.aeg.attack=56
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=80
t1.lfo1.wave=S&H
t1.lfo1.freq=34
t1.lfo1.keySync=Voice
t1.patch1.src=LFO1
t1.patch1.dst=Pitch
t1.patch1.int=4
t1.pitch.vibratoInt=8
t1.lfo2.freq=84
t1.amp.level=80
fx.mod.type=Ensemble
fx.mod.speed=58
fx.mod.depth=70
fx.delay.type=Stereo Delay
fx.delay.time=84
fx.delay.depth=22
