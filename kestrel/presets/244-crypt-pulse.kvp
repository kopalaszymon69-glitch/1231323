format=kestrel-program 1
name=Crypt Pulse
category=Dark Bass
author=Kestrel factory
description=Pulse-width-modulated bass: LFO1 slowly widens and narrows the pulse, so long notes breathe. Dark 24 dB filter, mono.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Square
t1.osc1.ctrl1=30
t1.osc1.ctrl2=40
t1.lfo1.wave=Triangle
t1.lfo1.freq=40
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=20
t1.filter.keyTrack=30
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.level=127
