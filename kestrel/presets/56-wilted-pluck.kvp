format=kestrel-program 1
name=Wilted Pluck
category=Sad Pluck
author=Kestrel factory
description=Saw + square sub pluck that closes quickly in a resonant 24 dB filter; dotted-sixteenth echoes.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=115
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=40
t1.filter.resonance=50
t1.filter.egInt=34
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=0
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=60
t1.aeg.sustain=0
t1.aeg.release=60
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=50
