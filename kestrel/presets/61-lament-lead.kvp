format=kestrel-program 1
name=Lament Lead
category=Dark Lead
author=Kestrel factory
description=Mono crying saw lead: slight detune, glide, MOD wheel vibrato at about 5 Hz, quarter echo and light chorus.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=40
t1.pitch.vibratoInt=10
t1.lfo2.freq=85
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.resonance=22
t1.filter.egInt=8
t1.filter.keyTrack=30
t1.feg.decay=70
t1.feg.sustain=60
t1.aeg.attack=10
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=50
t1.amp.level=96
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=40
fx.mod.type=Flanger/Chorus
fx.mod.depth=20
fx.mod.speed=52
