format=kestrel-program 1
name=Rain on Rhodes
category=Melancholic Keys
author=Kestrel factory
description=Dark DWGS E.Piano3 approximation: velocity on tone, slow tremolo, gentle phaser and a dotted echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=38
t1.osc2.wave=Triangle
t1.osc2.semitone=0
t1.mixer.osc1=127
t1.mixer.osc2=20
t1.filter.type=-12dB LPF
t1.filter.cutoff=66
t1.filter.resonance=8
t1.filter.egInt=14
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=70
t1.feg.sustain=20
t1.feg.release=50
t1.aeg.attack=0
t1.aeg.decay=98
t1.aeg.sustain=30
t1.aeg.release=60
t1.amp.level=118
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=8
t1.patch2.src=LFO2
t1.patch2.dst=Amp
t1.patch2.int=-10
t1.lfo2.freq=54
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Phaser
fx.mod.speed=12
fx.mod.depth=30
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=30
