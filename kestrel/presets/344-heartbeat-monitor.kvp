format=kestrel-program 1
name=Heartbeat Monitor
category=Dark FX
author=Kestrel factory
description=Hospital-monitor beep: a pure sine two octaves up, struck once per beat by the arpeggiator (Trigger, quarter notes, short gate). Hold one key; release it for silence.
arp.on=On
arp.type=Trigger
arp.resolution=1/4
arp.gate=14
arp.tempo=72
arp.keySync=On
t1.osc1.wave=Sine
t1.pitch.transpose=24
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=120
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=10
t1.amp.level=100
fx.delay.type=Stereo Delay
fx.delay.time=80
fx.delay.depth=16
