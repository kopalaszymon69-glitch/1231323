format=kestrel-program 1
name=Weeping Saw
category=Dark Lead
author=Kestrel factory
description=Mono saw lead with glide, a faint constant vibrato and more vibrato on the MOD wheel. Gently resonant 24 dB filter; dotted cross echoes and light chorus.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=44
t1.pitch.vibratoInt=10
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=72
t1.filter.resonance=20
t1.filter.egInt=6
t1.filter.keyTrack=30
t1.feg.attack=10
t1.feg.decay=80
t1.feg.sustain=60
t1.aeg.attack=8
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=50
t1.lfo2.wave=Sine
t1.lfo2.freq=85
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3
t1.amp.level=100
fx.mod.type=Flanger/Chorus
fx.mod.speed=54
fx.mod.depth=20
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=34
