format=kestrel-program 1
name=Requiem Piano
category=Melancholic Keys
author=Kestrel factory
description=Hollow piano-like keys: a gently folded triangle over a quiet saw an octave down, a struck filter envelope and a long decay. Velocity on level and tone.
t1.osc1.wave=Triangle
t1.osc1.ctrl1=20
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.egInt=10
t1.filter.keyTrack=36
t1.filter.velSense=16
t1.feg.attack=0
t1.feg.decay=70
t1.feg.sustain=10
t1.feg.release=50
t1.aeg.attack=0
t1.aeg.decay=100
t1.aeg.sustain=0
t1.aeg.release=64
t1.amp.velSense=40
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=52
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.time=96
fx.delay.depth=24
