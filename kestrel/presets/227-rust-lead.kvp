format=kestrel-program 1
name=Rust Lead
category=Dark Lead
author=Kestrel factory
description=Corroded lead: a saw and a square sub through a resonant 24 dB filter into the distortion stage. Glide, eighth-note echo.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=26
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=50
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.resonance=40
t1.filter.keyTrack=30
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=40
t1.amp.distortion=On
t1.lfo2.freq=85
t1.amp.level=110
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=24
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-4
