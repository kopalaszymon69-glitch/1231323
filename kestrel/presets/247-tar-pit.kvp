format=kestrel-program 1
name=Tar Pit
category=Dark Bass
author=Kestrel factory
description=Thick, distorted square sub: a hollow square with an octave-down square, a low 24 dB filter, then the distortion stage. Heavy and sticky.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Square
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=40
t1.filter.resonance=16
t1.filter.keyTrack=30
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.distortion=On
t1.amp.level=120
