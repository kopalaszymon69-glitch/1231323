format=kestrel-program 1
name=Last Light
category=Dark Pad
author=Kestrel factory
description=The light goes out: the filter opens at note-on and slowly closes over about five seconds while LFO1 shimmers the two-phase saw. A quiet fifth (OSC2 +7) shades the top.
t1.osc1.wave=Saw
t1.osc1.ctrl1=24
t1.osc1.ctrl2=60
t1.lfo1.wave=Triangle
t1.lfo1.freq=36
t1.osc2.wave=Saw
t1.osc2.semitone=7
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=20
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=10
t1.feg.decay=110
t1.feg.sustain=20
t1.feg.release=90
t1.aeg.attack=50
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=96
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=70
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=34
