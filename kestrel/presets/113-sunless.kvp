format=kestrel-program 1
name=Sunless
category=Dark Pad
author=Kestrel factory
description=Nasal, haunted pad: saw and square sub through a resonant 12 dB band-pass that LFO2 sweeps slowly over half an octave either way.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-12dB BPF
t1.filter.cutoff=66
t1.filter.resonance=50
t1.filter.keyTrack=24
t1.aeg.attack=72
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=94
t1.lfo2.wave=Sine
t1.lfo2.freq=16
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=3
t1.amp.level=61
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=70
fx.delay.type=Cross Delay
fx.delay.time=98
fx.delay.depth=34
