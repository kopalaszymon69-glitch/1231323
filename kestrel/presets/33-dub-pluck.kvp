format=kestrel-program 1
name=Dub Pluck
category=Deep House Pluck
author=Kestrel factory
description=Folded-triangle pluck into a band-pass with a long synced cross delay - dub chords.
t1.voice.assign=Poly
t1.osc1.wave=Triangle
t1.osc1.ctrl1=50
t1.osc2.wave=Saw
t1.osc2.semitone=7
t1.mixer.osc1=120
t1.mixer.osc2=70
t1.filter.type=-12dB BPF
t1.filter.cutoff=74
t1.filter.resonance=62
t1.filter.egInt=14
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=0
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=46
t1.amp.level=127
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=70
fx.mod.type=Flanger/Chorus
fx.mod.depth=16
