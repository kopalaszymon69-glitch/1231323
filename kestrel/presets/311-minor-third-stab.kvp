format=kestrel-program 1
name=Minor Third Stab
category=Dark Stab
author=Kestrel factory
description=One-finger sad stab: every key sounds a minor third (OSC2 +3 semitones). Short, punchy filter EG and an eighth-note echo.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=3
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=20
t1.filter.egInt=18
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=10
t1.aeg.attack=0
t1.aeg.decay=60
t1.aeg.sustain=0
t1.aeg.release=30
t1.amp.velSense=20
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=52
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=26
