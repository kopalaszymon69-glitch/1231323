format=kestrel-program 1
name=Snowblind
category=Dark Pad
author=Kestrel factory
description=Thin, icy pad: two saws an octave apart through a resonant 12 dB high-pass, so only a cold glassy band remains. Wide ensemble, long cross delay.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-12dB HPF
t1.filter.cutoff=62
t1.filter.resonance=34
t1.filter.keyTrack=48
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.amp.level=60
fx.mod.type=Ensemble
fx.mod.speed=60
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.time=112
fx.delay.depth=44
fx.eq.hiFreq=8.00kHz
fx.eq.hiGain=-3
