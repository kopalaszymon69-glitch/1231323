format=kestrel-program 1
name=Cracked Bell
category=Dark Bells
author=Kestrel factory
description=Cracked bell: a triangle ring-modulated by a square an octave up but about 25 cents sharp. One ring partial sits just above the root and beats against it a few times a second, the rough wobble of a cracked casting. Long decay.
t1.osc1.wave=Triangle
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.tune=7
t1.osc2.semitone=12
t1.mixer.osc1=100
t1.mixer.osc2=64
t1.filter.type=-12dB LPF
t1.filter.cutoff=92
t1.aeg.attack=0
t1.aeg.decay=100
t1.aeg.sustain=0
t1.aeg.release=90
t1.amp.velSense=24
t1.amp.level=120
fx.mod.type=Phaser
fx.mod.speed=30
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.time=96
fx.delay.depth=30
