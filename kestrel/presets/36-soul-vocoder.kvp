format=kestrel-program 1
name=Soul Vocoder
category=Deep House Vocoder
author=Kestrel factory
description=Vocoder chords with a VOX-wave carrier, consonant HPF only while keys are held, ensemble. Sing into AUDIO IN 1.
prog.voiceMode=Vocoder
t1.voice.assign=Poly
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=30
t1.aeg.attack=2
t1.aeg.decay=70
t1.aeg.sustain=110
t1.aeg.release=40
voc.mixer.osc1=127
voc.mixer.noise=6
voc.filter.formantShift=0
voc.filter.resonance=20
voc.filter.efSense=24
voc.in1.threshold=16
voc.in1.hpfLevel=44
voc.in1.hpfGate=Enable
voc.amp.level=127
voc.ch7.level=110
voc.ch8.level=100
voc.ch1.pan=-20
voc.ch2.pan=20
voc.ch3.pan=-30
voc.ch4.pan=30
fx.mod.type=Ensemble
fx.mod.depth=55
fx.delay.depth=16
