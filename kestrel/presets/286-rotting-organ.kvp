format=kestrel-program 1
name=Rotting Organ
category=Dark Drone
author=Kestrel factory
description=Decayed organ drone: DWGS Organ7 approximation with slow random pitch drift of a few cents (LFO1 sample & hold), light distortion and a slow phaser.
t1.osc1.wave=DWGS
t1.osc1.dwgs=46
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=80
t1.lfo1.wave=S&H
t1.lfo1.freq=26
t1.patch1.src=LFO1
t1.patch1.dst=Pitch
t1.patch1.int=4
t1.amp.distortion=On
t1.amp.level=70
fx.mod.type=Phaser
fx.mod.speed=22
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=26
