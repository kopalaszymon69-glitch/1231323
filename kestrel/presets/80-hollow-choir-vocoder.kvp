format=kestrel-program 1
name=Hollow Choir Vocoder
category=Dark Vocoder
author=Kestrel factory
description=Vocoder with a VOX carrier, formants shifted down two steps (darker, larger), resonant bands, ensemble. Sing into AUDIO IN 1.
prog.voiceMode=Vocoder
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=40
t1.aeg.attack=20
t1.aeg.decay=80
t1.aeg.sustain=118
t1.aeg.release=70
voc.mixer.osc1=127
voc.mixer.noise=4
voc.filter.formantShift=-2
voc.filter.resonance=50
voc.filter.efSense=50
voc.in1.threshold=18
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=34
