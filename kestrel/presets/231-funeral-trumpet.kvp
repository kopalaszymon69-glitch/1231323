format=kestrel-program 1
name=Funeral Trumpet
category=Dark Lead
author=Kestrel factory
description=Muted brass lead: a saw whose filter EG swells in over 60 ms and settles, like a soft trumpet attack; velocity on brightness; MOD wheel vibrato.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.pitch.portamento=14
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=2
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=8
t1.filter.egInt=12
t1.filter.keyTrack=36
t1.filter.velSense=20
t1.feg.attack=30
t1.feg.decay=70
t1.feg.sustain=70
t1.feg.release=40
t1.aeg.attack=10
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=40
t1.lfo2.freq=84
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.time=92
fx.delay.depth=24
