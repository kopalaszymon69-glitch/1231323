format=kestrel-program 1
name=Hush Pluck
category=Sad Pluck
author=Kestrel factory
description=Very soft, close pluck: a triangle with a little breath noise, a 12 dB low-pass and a long, quiet cross-delay tail. For sparse late-night melodies.
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.mixer.noise=10
t1.filter.type=-12dB LPF
t1.filter.cutoff=68
t1.filter.keyTrack=36
t1.aeg.attack=2
t1.aeg.decay=70
t1.aeg.sustain=0
t1.aeg.release=70
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=40
