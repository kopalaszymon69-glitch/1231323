format=kestrel-program 1
name=Doom Chord
category=Dark Stab
author=Kestrel factory
description=Distorted power-fifth stab: saw plus a saw a fifth up into the distortion stage, a dark 24 dB filter and a short decay. One key, one doom chord.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=7
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=16
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=56
t1.feg.sustain=30
t1.aeg.attack=0
t1.aeg.decay=76
t1.aeg.sustain=40
t1.aeg.release=30
t1.amp.distortion=On
t1.amp.level=90
fx.mod.type=Phaser
fx.mod.speed=34
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=20
