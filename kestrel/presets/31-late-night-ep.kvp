format=kestrel-program 1
name=Late Night EP
category=Deep House Keys
author=Kestrel factory
description=DWGS E.Piano1 approximation with velocity on level and tone, gentle LFO2 auto-pan and ensemble.
t1.voice.assign=Poly
t1.osc1.wave=DWGS
t1.osc1.dwgs=36
t1.osc2.wave=Triangle
t1.osc2.semitone=0
t1.mixer.osc1=127
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=86
t1.filter.resonance=0
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=100
t1.aeg.sustain=30
t1.aeg.release=50
t1.amp.level=70
t1.patch1.src=Velocity
t1.patch1.dst=Amp
t1.patch1.int=28
t1.patch2.src=Velocity
t1.patch2.dst=Cutoff
t1.patch2.int=16
t1.patch3.src=LFO2
t1.patch3.dst=Pan
t1.patch3.int=24
t1.lfo2.freq=58
t1.patch4.int=0
fx.mod.type=Ensemble
fx.mod.speed=16
fx.mod.depth=46
fx.delay.depth=0
