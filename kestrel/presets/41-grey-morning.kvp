format=kestrel-program 1
name=Grey Morning
category=Dark Pad
author=Kestrel factory
description=Muted PWM pad: slow LFO1 pulse-width motion, square sub an octave down, soft 12 dB low-pass, slow chorus.
t1.osc1.wave=Square
t1.osc1.ctrl1=30
t1.osc1.ctrl2=45
t1.lfo1.wave=Triangle
t1.lfo1.freq=26
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=118
t1.mixer.osc2=50
t1.filter.type=-12dB LPF
t1.filter.cutoff=58
t1.filter.resonance=18
t1.filter.keyTrack=24
t1.aeg.attack=80
t1.aeg.decay=90
t1.aeg.sustain=120
t1.aeg.release=100
t1.amp.level=58
fx.mod.type=Flanger/Chorus
fx.mod.speed=8
fx.mod.depth=50
fx.delay.depth=26
fx.delay.time=100
fx.eq.hiFreq=5.00kHz
fx.eq.hiGain=-6
