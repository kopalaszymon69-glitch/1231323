format=kestrel-program 1
name=Black Ice
category=Dark Drone
author=Kestrel factory
description=Cold whistling drone: saws through a resonant 12 dB high-pass that LFO2 sweeps slowly, leaving a thin, icy ring. Wide ensemble.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=7
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-12dB HPF
t1.filter.cutoff=70
t1.filter.resonance=70
t1.filter.keyTrack=24
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.lfo2.wave=Sine
t1.lfo2.freq=16
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=5
t1.amp.level=64
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=90
fx.delay.type=Cross Delay
fx.delay.time=112
fx.delay.depth=40
