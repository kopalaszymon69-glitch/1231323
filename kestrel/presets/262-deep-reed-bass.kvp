format=kestrel-program 1
name=Deep Reed Bass
category=Dark Bass
author=Kestrel factory
description=Reedy contrabassoon-like bass: a narrow pulse with a square an octave below through a gently resonant 24 dB filter. Mono.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Square
t1.osc1.ctrl1=90
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=20
t1.filter.keyTrack=30
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.level=120
