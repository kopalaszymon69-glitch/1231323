format=kestrel-program 1
name=Melancholy EP
category=Melancholic Keys
author=Kestrel factory
description=Rounder electric piano (DWGS E.Piano2 approximation) with a slightly flat triangle octave for shimmer, gentle tremolo and velocity response.
t1.osc1.wave=DWGS
t1.osc1.dwgs=37
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=-2
t1.mixer.osc1=120
t1.mixer.osc2=24
t1.filter.type=-12dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.aeg.attack=0
t1.aeg.decay=94
t1.aeg.sustain=26
t1.aeg.release=60
t1.amp.velSense=36
t1.lfo2.wave=Sine
t1.lfo2.freq=82
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-6
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=58
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=20
