format=kestrel-program 1
name=Quiet Ruin
category=Dark Pad
author=Kestrel factory
description=Faded vocal pad from the DWGS Voice3 approximation with a saw a fifth below for weight; slow MOD-wheel vibrato; ensemble and a half-note echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=63
t1.osc2.wave=Saw
t1.osc2.semitone=-5
t1.mixer.osc1=120
t1.mixer.osc2=36
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.keyTrack=24
t1.pitch.vibratoInt=8
t1.lfo2.freq=84
t1.aeg.attack=72
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=70
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=30
