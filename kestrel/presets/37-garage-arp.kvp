format=kestrel-program 1
name=Garage Swing Arp
category=Deep House Arp
author=Kestrel factory
description=Swung (+30%) Alt1 arpeggio of a short organ stab with a 5-step pattern (step 4 muted). Hold a 7th chord.
arp.on=On
arp.type=Alt1
arp.range=1
arp.resolution=1/16
arp.gate=55
arp.swing=30
arp.tempo=124
arp.lastStep=5
arp.step4=Off
arp.keySync=On
t1.voice.assign=Poly
t1.osc1.wave=DWGS
t1.osc1.dwgs=40
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.resonance=24
t1.filter.egInt=16
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.feg.release=20
t1.aeg.attack=0
t1.aeg.decay=46
t1.aeg.sustain=20
t1.aeg.release=24
t1.amp.level=120
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=28
fx.mod.type=Flanger/Chorus
fx.mod.depth=20
