format=kestrel-program 1
name=Ghost Whistle
category=Dark Lead
author=Kestrel factory
description=Self-oscillating filter played as a whistle: resonance 127, cutoff 52 tracks the keyboard 1:1 (KEY TRACK +48) and sits in tune; a breath of noise excites it. Mono with glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.mixer.osc1=0
t1.mixer.osc2=0
t1.mixer.noise=12
t1.filter.type=-12dB LPF
t1.filter.cutoff=52
t1.filter.resonance=127
t1.filter.keyTrack=48
t1.aeg.attack=30
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=46
t1.amp.level=110
t1.lfo2.wave=Sine
t1.lfo2.freq=68
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=46
fx.delay.type=Cross Delay
