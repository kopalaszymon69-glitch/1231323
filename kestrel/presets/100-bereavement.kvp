format=kestrel-program 1
name=Bereavement
category=Dark Pad
author=Kestrel factory
description=Warm, slow saw pad. The filter EG rises over two seconds and settles low; LFO1 slowly shimmers the two-phase saw. Ensemble and a quarter-note cross delay.
t1.osc1.wave=Saw
t1.osc1.ctrl1=20
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=96
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=14
t1.filter.egInt=8
t1.filter.keyTrack=24
t1.feg.attack=90
t1.feg.decay=100
t1.feg.sustain=70
t1.feg.release=96
t1.aeg.attack=84
t1.aeg.decay=90
t1.aeg.sustain=120
t1.aeg.release=96
t1.amp.level=84
fx.mod.type=Ensemble
fx.mod.speed=55
fx.mod.depth=70
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=30
