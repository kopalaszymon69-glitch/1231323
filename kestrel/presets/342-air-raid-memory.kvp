format=kestrel-program 1
name=Air Raid Memory
category=Dark FX
author=Kestrel factory
description=Distant siren: LFO1 (about 4 s per cycle) sweeps the pitch up and down about eight semitones on a square, band-passed and drenched in long echoes.
t1.osc1.wave=Square
t1.mixer.osc1=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=80
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=90
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.lfo1.keySync=Timbre
t1.patch1.src=LFO1
t1.patch1.dst=Pitch
t1.patch1.int=40
t1.amp.level=90
fx.mod.type=Phaser
fx.mod.speed=30
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=110
fx.delay.depth=50
