format=kestrel-program 1
name=Violin Ghost
category=Dark Lead
author=Kestrel factory
description=Bowed solo string: a saw with a 60 ms bow attack, a constant 5.5 Hz vibrato, a resonant 24 dB filter and velocity on brightness. Light glide between legato notes.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=24
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.resonance=24
t1.filter.keyTrack=40
t1.filter.velSense=20
t1.aeg.attack=30
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=44
t1.lfo2.wave=Sine
t1.lfo2.freq=86
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=4
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=24
