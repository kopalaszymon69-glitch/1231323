format=kestrel-program 1
name=Cold Organ
category=Melancholic Keys
author=Kestrel factory
description=DWGS Organ3 approximation, slightly closed; MOD wheel vibrato and a slow phaser.
t1.osc1.wave=DWGS
t1.osc1.dwgs=42
t1.mixer.osc1=120
t1.mixer.osc2=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.pitch.vibratoInt=8
t1.lfo2.freq=72
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=34
t1.amp.level=96
fx.mod.type=Phaser
fx.mod.speed=10
fx.mod.depth=50
fx.delay.depth=18
