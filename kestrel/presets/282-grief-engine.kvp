format=kestrel-program 1
name=Grief Engine
category=Dark Drone
author=Kestrel factory
description=Grinding sync drone: LFO1 very slowly drags the synced OSC2 (patch to OSC2 Tune) through a resonant 24 dB filter, while a slow phaser turns it.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=10
t1.mixer.osc1=40
t1.mixer.osc2=110
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.resonance=70
t1.filter.keyTrack=24
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.lfo1.wave=Triangle
t1.lfo1.freq=12
t1.patch1.src=LFO1
t1.patch1.dst=OSC2 Tune
t1.patch1.int=26
t1.amp.level=90
fx.mod.type=Phaser
fx.mod.speed=24
fx.mod.depth=64
fx.delay.type=Cross Delay
fx.delay.time=106
fx.delay.depth=30
