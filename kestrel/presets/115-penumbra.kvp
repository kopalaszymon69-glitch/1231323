format=kestrel-program 1
name=Penumbra
category=Dark Pad
author=Kestrel factory
description=Digital fifth-wave pad (DWGS 5thWave1 approximation) behind a closed 24 dB filter with a slow upward bloom; phaser.
t1.osc1.wave=DWGS
t1.osc1.dwgs=24
t1.mixer.osc1=120
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=16
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.feg.attack=96
t1.feg.decay=100
t1.feg.sustain=80
t1.feg.release=90
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=120
fx.mod.type=Phaser
fx.mod.speed=34
fx.mod.depth=56
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=30
