format=kestrel-program 1
name=Hollow Fifth Bass
category=Dark Bass
author=Kestrel factory
description=Power-fifth bass: saw plus a saw a fifth above under a low 24 dB filter, so each note is a dark, open "power chord" root.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=7
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=16
t1.filter.keyTrack=24
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.level=127
