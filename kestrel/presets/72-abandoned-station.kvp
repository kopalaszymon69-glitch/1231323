format=kestrel-program 1
name=Abandoned Station
category=Dark Drone
author=Kestrel factory
description=Hollow ring-modulated drone: a triangle against a square an octave below (in key, with a subharmonic), whose tuning LFO2 slowly pulls a few tens of cents sharp and back, so it beats uneasily. Band-pass and long echoes.
t1.osc1.wave=Triangle
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=-12
t1.osc2.tune=2
t1.mixer.osc1=40
t1.mixer.osc2=120
t1.filter.type=-12dB BPF
t1.filter.cutoff=68
t1.filter.resonance=50
t1.filter.keyTrack=24
t1.aeg.attack=56
t1.aeg.decay=80
t1.aeg.sustain=118
t1.aeg.release=92
t1.amp.level=80
t1.lfo2.wave=Sine
t1.lfo2.freq=12
t1.patch1.src=LFO2
t1.patch1.dst=OSC2 Tune
t1.patch1.int=6
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=L/R Delay
fx.delay.time=110
fx.delay.depth=50
fx.mod.type=Ensemble
fx.mod.depth=40
fx.mod.speed=44
