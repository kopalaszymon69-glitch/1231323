format=kestrel-program 1
name=Hymn for the Drowned
category=Dark Strings & Choir
author=Kestrel factory
description=Submerged choir: Vox wave over a square two octaves down, under a dark 24 dB low-pass; a slow phaser makes it sway like water. Half-note cross delay.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=20
t1.osc2.wave=Square
t1.osc2.semitone=-24
t1.mixer.osc1=120
t1.mixer.osc2=36
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=14
t1.filter.keyTrack=30
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.amp.level=120
fx.mod.type=Phaser
fx.mod.speed=28
fx.mod.depth=64
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=38
