format=kestrel-program 1
name=Dark Dulcimer
category=Sad Pluck
author=Kestrel factory
description=Hammered double course: two saws 8 cents apart that beat like paired strings, a struck 12 dB filter and a long decay.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=110
t1.filter.type=-12dB LPF
t1.filter.cutoff=64
t1.filter.resonance=10
t1.filter.egInt=12
t1.filter.keyTrack=36
t1.feg.attack=0
t1.feg.decay=56
t1.feg.sustain=10
t1.aeg.attack=0
t1.aeg.decay=92
t1.aeg.sustain=0
t1.aeg.release=64
t1.amp.velSense=34
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=22
