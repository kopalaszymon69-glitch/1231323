format=kestrel-program 1
name=Sorrow 808
category=Dark Bass
author=Kestrel factory
description=Sad-trap 808: a sine that drops about a semitone in its first 60 ms (filter EG to pitch), a long decaying tail and light saturation. Legato glide for slides.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.pitch.portamento=34
t1.osc1.wave=Sine
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=100
t1.feg.attack=0
t1.feg.decay=30
t1.feg.sustain=0
t1.feg.release=10
t1.aeg.attack=0
t1.aeg.decay=100
t1.aeg.sustain=0
t1.aeg.release=60
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=14
t1.amp.distortion=On
t1.amp.level=127
