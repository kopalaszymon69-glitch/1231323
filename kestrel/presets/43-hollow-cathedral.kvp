format=kestrel-program 1
name=Hollow Cathedral
category=Dark Pad
author=Kestrel factory
description=DWGS Organ7 approximation with a soft triangle octave, slow swell, slow phaser and long L/R echoes.
t1.osc1.wave=DWGS
t1.osc1.dwgs=46
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.resonance=8
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=90
t1.amp.level=100
fx.mod.type=Phaser
fx.mod.speed=32
fx.mod.depth=55
fx.delay.type=L/R Delay
fx.delay.time=104
fx.delay.depth=44
