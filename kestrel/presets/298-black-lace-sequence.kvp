format=kestrel-program 1
name=Black Lace Sequence
category=Dark Arp
author=Kestrel factory
description=Up arpeggio over two octaves with a six-step loop (Last Step 6), so the pattern shifts against the bar. Resonant pulse pluck, dotted echoes.
arp.on=On
arp.type=Up
arp.range=2
arp.resolution=1/16
arp.gate=50
arp.tempo=100
arp.keySync=On
arp.lastStep=6
t1.osc1.wave=Square
t1.osc1.ctrl1=60
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=56
t1.filter.resonance=50
t1.filter.egInt=14
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.level=96
fx.mod.type=Flanger/Chorus
fx.mod.speed=44
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=36
