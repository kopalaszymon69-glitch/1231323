format=kestrel-program 1
name=Black Mass Bass
category=Dark Bass
author=Kestrel factory
description=Growling bass: a triangle ring-modulated by a square an octave down adds a hollow subharmonic snarl; resonant low 24 dB filter and distortion.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Triangle
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=-12
t1.mixer.osc1=90
t1.mixer.osc2=110
t1.filter.type=-24dB LPF
t1.filter.cutoff=46
t1.filter.resonance=30
t1.filter.keyTrack=30
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.amp.distortion=On
t1.amp.level=100
