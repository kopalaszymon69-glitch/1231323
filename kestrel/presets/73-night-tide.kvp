format=kestrel-program 1
name=Night Tide
category=Dark Drone
author=Kestrel factory
description=Filtered OSC1 noise like distant surf: LFO2 sweeps the noise cutoff (patch to OSC1 Control 1). Hold any note.
t1.osc1.wave=Noise
t1.osc1.ctrl1=50
t1.osc1.ctrl2=60
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=86
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=96
t1.amp.level=127
t1.lfo2.wave=Sine
t1.lfo2.freq=14
t1.patch1.src=LFO2
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=20
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.time=120
fx.delay.depth=40
fx.mod.type=Ensemble
fx.mod.depth=50
