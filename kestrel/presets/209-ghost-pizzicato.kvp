format=kestrel-program 1
name=Ghost Pizzicato
category=Sad Pluck
author=Kestrel factory
description=Plucked strings for creeping horror cues: two slightly detuned saws, a very short filter snap and decay, ensemble.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.egInt=16
t1.filter.keyTrack=36
t1.feg.attack=0
t1.feg.decay=36
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.velSense=36
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=60
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.time=74
fx.delay.depth=16
