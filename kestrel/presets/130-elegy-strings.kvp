format=kestrel-program 1
name=Elegy Strings
category=Dark Strings & Choir
author=Kestrel factory
description=String-machine ensemble: two saws 8 cents apart through a soft 12 dB low-pass and a full-depth ensemble. Moderate attack; MOD wheel adds vibrato.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.resonance=6
t1.filter.keyTrack=24
t1.aeg.attack=64
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=84
t1.pitch.vibratoInt=8
t1.lfo2.freq=86
t1.amp.level=70
fx.mod.type=Ensemble
fx.mod.speed=62
fx.mod.depth=100
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=22
