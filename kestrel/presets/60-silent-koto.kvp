t1.filter.resonance=20
t1.filter.egInt=12
t1.feg.decay=56
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=74
t1.aeg.sustain=0
t1.aeg.release=64
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=46
