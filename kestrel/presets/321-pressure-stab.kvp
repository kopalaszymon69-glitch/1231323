format=kestrel-program 1
name=Pressure Stab
category=Dark Stab
author=Kestrel factory
description=Tense sync stab: the filter EG sweeps a hard-synced OSC2 down from high overtones at every hit, behind a dark 24 dB filter. Short and aggressive.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=12
t1.mixer.osc1=30
t1.mixer.osc2=120
t1.filter.type=-24dB LPF
t1.filter.cutoff=80
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=60
t1.aeg.sustain=20
t1.aeg.release=30
t1.patch1.src=Filter EG
t1.patch1.dst=OSC2 Tune
t1.patch1.int=40
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=20
