format=kestrel-program 1
name=Velvet Pluck
category=Sad Pluck
author=Kestrel factory
description=Rounded, slightly sustaining pluck: square plus sub, a gently resonant 24 dB filter and a small sustain, so held notes linger quietly. Chorus.
t1.osc1.wave=Square
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=30
t1.filter.egInt=12
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=60
t1.feg.sustain=10
t1.aeg.attack=4
t1.aeg.decay=70
t1.aeg.sustain=24
t1.aeg.release=60
t1.amp.velSense=30
t1.amp.level=90
fx.mod.type=Flanger/Chorus
fx.mod.speed=52
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=24
