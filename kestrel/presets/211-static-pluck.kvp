format=kestrel-program 1
name=Static Pluck
category=Sad Pluck
author=Kestrel factory
description=A burst of noise rides on each pluck (amp EG to noise level), over a triangle body: like a scratchy old record. Short, dry and a little broken.
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.mixer.noise=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.filter.keyTrack=30
t1.aeg.attack=0
t1.aeg.decay=52
t1.aeg.sustain=0
t1.aeg.release=44
t1.patch1.src=Amp EG
t1.patch1.dst=Noise Level
t1.patch1.int=12
t1.amp.velSense=20
t1.amp.level=127
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=24
fx.eq.hiFreq=5.00kHz
fx.eq.hiGain=-4
