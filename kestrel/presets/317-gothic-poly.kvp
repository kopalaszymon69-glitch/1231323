format=kestrel-program 1
name=Gothic Poly
category=Dark Stab
author=Kestrel factory
description=All-round dark poly synth: saw plus square sub, a resonant 24 dB filter with a moderate envelope, full sustain. A starting point for chords and riffs.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=24
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.filter.velSense=12
t1.feg.attack=0
t1.feg.decay=64
t1.feg.sustain=40
t1.feg.release=30
t1.aeg.attack=2
t1.aeg.decay=70
t1.aeg.sustain=100
t1.aeg.release=40
t1.amp.velSense=20
t1.amp.level=84
fx.mod.type=Ensemble
fx.mod.speed=54
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=20
