format=kestrel-program 1
name=Coldwave Brass
category=Dark Stab
author=Kestrel factory
description=Dark synth brass: two detuned saws with a filter EG that blooms and settles, quick attack and medium release. Velocity on brightness. Big minor chords.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=14
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.feg.attack=10
t1.feg.decay=64
t1.feg.sustain=50
t1.feg.release=30
t1.aeg.attack=4
t1.aeg.decay=70
t1.aeg.sustain=100
t1.aeg.release=34
t1.amp.velSense=20
t1.amp.level=76
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=16
