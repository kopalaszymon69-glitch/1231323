format=kestrel-program 1
name=Lost Signal
category=Dark Pad
author=Kestrel factory
description=Resonant key-tracked OSC1 noise (a ghostly tone) over a low saw; sample & hold flutter on the cutoff.
t1.osc1.wave=Noise
t1.osc1.ctrl1=40
t1.osc1.ctrl2=96
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=127
t1.mixer.osc2=55
t1.filter.type=-24dB LPF
t1.filter.cutoff=64
t1.filter.resonance=24
t1.filter.keyTrack=30
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=115
t1.aeg.release=90
t1.amp.level=110
t1.lfo1.wave=S&H
t1.lfo1.freq=44
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=3
fx.mod.type=Ensemble
fx.mod.depth=70
fx.delay.type=Cross Delay
fx.delay.time=96
fx.delay.depth=40
fx.mod.speed=50
