format=kestrel-program 1
name=Teardrop
category=Sad Pluck
author=Kestrel factory
description=A falling drop: a triangle pluck whose pitch slides down about half a semitone in the first 30 ms (filter EG to pitch), with dotted-sixteenth cross echoes.
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.feg.attack=0
t1.feg.decay=20
t1.feg.sustain=0
t1.feg.release=10
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=50
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=10
t1.amp.velSense=24
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=44
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc2=40
