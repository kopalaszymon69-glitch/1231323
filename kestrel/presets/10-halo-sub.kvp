format=kestrel-program 1
name=Halo Sub
category=Angelcore Bass
author=Kestrel factory
description=Clean gliding sine sub with a quiet octave triangle; sits under airy pads. Mono, legato glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=55
t1.pitch.bendRange=2
t1.osc1.wave=Sine
t1.osc1.ctrl1=0
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=18
t1.mixer.noise=0
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=0
t1.filter.egInt=8
t1.filter.keyTrack=48
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=0
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=90
t1.aeg.sustain=110
t1.aeg.release=40
t1.amp.level=120
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=12
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.eq.lowFreq=60Hz
fx.eq.lowGain=3
fx.eq.hiFreq=8.00kHz
fx.eq.hiGain=-4
