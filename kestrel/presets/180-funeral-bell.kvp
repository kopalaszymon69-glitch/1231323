format=kestrel-program 1
name=Funeral Bell
category=Dark Bells
author=Kestrel factory
description=Large low bell: an FM sine whose partials (OSC2 an octave up, about 8 cents sharp, so they beat slowly) die away faster than the body, because the amp EG also drives the cross-modulation. Very long decay.
t1.osc1.wave=Sine
t1.osc1.ctrl1=24
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=0
t1.aeg.decay=108
t1.aeg.sustain=0
t1.aeg.release=100
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=30
t1.amp.velSense=24
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=24
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=30
t1.osc2.tune=4
