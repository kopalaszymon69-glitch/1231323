format=kestrel-program 1
name=Falling Ash
category=Dark Arp
author=Kestrel factory
description=Triplet Down arpeggio over three octaves: soft triangle plucks drifting downward like ash, with a long stereo echo.
arp.on=On
arp.type=Down
arp.range=3
arp.resolution=1/12
arp.gate=40
arp.tempo=80
arp.keySync=On
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=24
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=30
t1.aeg.attack=0
t1.aeg.decay=62
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=36
