format=kestrel-program 1
name=Requiem Arp Pad
category=Dark Arp
author=Kestrel factory
description=Arpeggiated pad: slow quarter-note Up arpeggio over two octaves where each note has a slow attack and a long release, so the notes overlap into a moving chord.
arp.on=On
arp.type=Up
arp.range=2
arp.resolution=1/4
arp.gate=90
arp.tempo=76
arp.keySync=On
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=16
t1.filter.keyTrack=24
t1.aeg.attack=56
t1.aeg.decay=80
t1.aeg.sustain=110
t1.aeg.release=90
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=30
