format=kestrel-program 1
name=Requiem Steps
category=Dark Arp
author=Kestrel factory
description=Up arpeggio with a broken 7-step pattern (steps 3 and 6 muted) of a folded-triangle pluck; heavy dotted echo.
arp.on=On
arp.type=Up
arp.range=1
arp.resolution=1/16
arp.gate=40
arp.tempo=100
arp.lastStep=7
arp.step3=Off
arp.step6=Off
arp.keySync=On
t1.osc1.wave=Triangle
t1.osc1.ctrl1=48
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=40
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=40
t1.filter.egInt=26
t1.filter.keyTrack=24
t1.feg.decay=42
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=10
t1.aeg.release=36
t1.amp.level=120
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=56
