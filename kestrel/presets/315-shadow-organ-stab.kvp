format=kestrel-program 1
name=Shadow Organ Stab
category=Dark Stab
author=Kestrel factory
description=Percussive organ chord (DWGS Organ3 approximation): a short decay into a low sustain and a filter click, with a long stereo echo behind it.
t1.osc1.wave=DWGS
t1.osc1.dwgs=42
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=30
t1.aeg.release=30
t1.amp.level=110
fx.mod.type=Flanger/Chorus
fx.mod.speed=76
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.time=94
fx.delay.depth=30
