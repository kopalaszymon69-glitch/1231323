format=kestrel-program 1
name=Coldwave Bass
category=Dark Bass
author=Kestrel factory
description=Post-punk picked bass: saw plus square sub, a resonant 24 dB filter with a quick pick transient, retriggered on every note. Velocity on tone.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=52
t1.filter.resonance=20
t1.filter.egInt=14
t1.filter.keyTrack=24
t1.filter.velSense=16
t1.feg.attack=0
t1.feg.decay=44
t1.feg.sustain=10
t1.feg.release=20
t1.aeg.attack=0
t1.aeg.decay=80
t1.aeg.sustain=70
t1.aeg.release=20
t1.amp.velSense=20
t1.amp.level=110
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=20
