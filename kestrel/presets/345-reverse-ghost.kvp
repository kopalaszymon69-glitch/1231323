format=kestrel-program 1
name=Reverse Ghost
category=Dark FX
author=Kestrel factory
description=Backwards-sounding swell: a Vox wave with breath noise rises over about a second and cuts off on release, feeding a deep cross delay so the ghost repeats.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=60
t1.mixer.osc1=127
t1.mixer.noise=20
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.filter.keyTrack=24
t1.aeg.attack=84
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=4
t1.amp.level=86
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=70
