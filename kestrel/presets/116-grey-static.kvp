format=kestrel-program 1
name=Grey Static
category=Dark Pad
author=Kestrel factory
description=Hissing analog pad: saw with plenty of noise through a resonant low-pass; slow sample & hold nudges the cutoff a few semitones now and then.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=-4
t1.mixer.osc1=100
t1.mixer.osc2=80
t1.mixer.noise=40
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=40
t1.filter.keyTrack=24
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=88
t1.lfo2.wave=S&H
t1.lfo2.freq=50
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=1.5
t1.amp.level=80
fx.mod.type=Flanger/Chorus
fx.mod.speed=40
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=80
fx.delay.depth=24
