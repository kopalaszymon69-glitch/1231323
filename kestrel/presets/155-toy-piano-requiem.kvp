format=kestrel-program 1
name=Toy Piano Requiem
category=Melancholic Keys
author=Kestrel factory
description=Little metal tines: a sine cross-modulated by OSC2 two octaves up, a quick decay and a long tail. Velocity sets the level. Sounds lonely in the upper octaves.
t1.osc1.wave=Sine
t1.osc1.ctrl1=50
t1.osc2.wave=Triangle
t1.osc2.semitone=24
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=104
t1.aeg.attack=0
t1.aeg.decay=76
t1.aeg.sustain=0
t1.aeg.release=70
t1.amp.velSense=40
t1.amp.level=110
fx.mod.type=Flanger/Chorus
fx.mod.speed=52
fx.mod.depth=14
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=34
