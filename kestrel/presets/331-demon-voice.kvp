format=kestrel-program 1
name=Demon Voice
category=Dark Vocoder
author=Kestrel factory
description=Huge, low vocoder voice: the carrier is two saws an octave down, formants shifted down two steps, plus noise and the vocoder distortion. Play single low notes or fifths.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.osc1.ctrl1=64
t1.pitch.transpose=-12
t1.aeg.attack=4
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=50
voc.mixer.osc1=127
voc.mixer.noise=24
voc.filter.formantShift=-2
voc.filter.resonance=30
voc.filter.efSense=30
voc.in1.threshold=12
voc.amp.distortion=On
voc.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=30
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=20
