format=kestrel-program 1
name=Hollow Prayer
category=Dark Vocoder
author=Kestrel factory
description=Soft, hollow vocoder: a folded triangle carrier with a little noise, gentle bands and a slow attack. Intimate and fragile; speak quietly.
prog.voiceMode=Vocoder
t1.osc1.wave=Triangle
t1.osc1.ctrl1=50
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=70
voc.mixer.osc1=127
voc.mixer.noise=16
voc.filter.formantShift=0
voc.filter.resonance=20
voc.filter.efSense=40
voc.in1.threshold=8
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=30
