t1.filter.egInt=12
t1.filter.keyTrack=24
t1.feg.attack=120
t1.feg.decay=100
t1.feg.sustain=127
t1.feg.release=100
t1.aeg.attack=90
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=110
t1.amp.level=96
fx.mod.type=Ensemble
