format=kestrel-program 1
name=Old Piano Ghost
category=Melancholic Keys
author=Kestrel factory
description=DWGS E.Piano4 approximation with a faint saw octave below, darkened; ensemble and a short echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=39
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.mixer.osc1=127
t1.mixer.osc2=20
t1.filter.type=-24dB LPF
t1.filter.cutoff=72
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.feg.decay=80
t1.feg.sustain=30
t1.aeg.attack=0
t1.aeg.decay=94
t1.aeg.sustain=20
t1.aeg.release=70
t1.amp.level=118
fx.mod.type=Ensemble
fx.mod.depth=40
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=24
