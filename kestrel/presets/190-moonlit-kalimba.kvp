format=kestrel-program 1
name=Moonlit Kalimba
category=Dark Bells
author=Kestrel factory
description=Thumb-piano pluck: a sine with a short burst of cross-modulation (amp EG to CONTROL 1) from OSC2 an octave and a fifth up, short decay, dotted echoes.
t1.osc1.wave=Sine
t1.osc1.ctrl1=6
t1.osc2.wave=Triangle
t1.osc2.semitone=19
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=0
t1.aeg.release=56
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=22
t1.amp.velSense=36
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=32
