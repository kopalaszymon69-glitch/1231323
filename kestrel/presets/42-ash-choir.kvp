format=kestrel-program 1
name=Ash Choir
category=Dark Pad
author=Kestrel factory
description=VOX-wave choir through a resonant band-pass; LFO1 slowly reshapes the waveform. Wide ensemble, half-note cross delay.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=64
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=20
t1.osc2.wave=Saw
t1.osc2.tune=-6
t1.mixer.osc1=127
t1.mixer.osc2=40
t1.filter.type=-12dB BPF
t1.filter.cutoff=78
t1.filter.resonance=40
t1.filter.keyTrack=30
t1.aeg.attack=74
t1.aeg.decay=80
t1.aeg.sustain=115
t1.aeg.release=92
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=10
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=45
