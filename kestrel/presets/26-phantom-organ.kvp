format=kestrel-program 1
name=Phantom Organ
category=Witch House Keys
author=Kestrel factory
description=Detuned DWGS Organ5 layer: timbre 2 is a pitched-down sine for weight. Phaser, MOD wheel vibrato. (Layer: 2 notes in compatibility mode.)
prog.voiceMode=Layer
t1.voice.assign=Poly
t2.voice.assign=Poly
t1.osc1.wave=DWGS
t1.osc1.dwgs=44
t1.mixer.osc1=120
t1.mixer.osc2=0
t1.filter.cutoff=104
t1.pitch.vibratoInt=8
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=30
t1.amp.level=100
t1.amp.pan=-20
t2.osc1.wave=Sine
t2.pitch.transpose=-12
t2.pitch.tune=-6
t2.mixer.osc1=110
t2.mixer.osc2=0
t2.filter.cutoff=127
t2.pitch.vibratoInt=8
t2.aeg.attack=10
t2.aeg.decay=64
t2.aeg.sustain=127
t2.aeg.release=40
t2.amp.level=90
t2.amp.pan=20
t1.patch1.int=0
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
t2.patch1.int=0
t2.patch2.int=0
t2.patch3.int=0
t2.patch4.int=0
fx.mod.type=Phaser
fx.mod.speed=24
fx.mod.depth=60
fx.delay.depth=20
