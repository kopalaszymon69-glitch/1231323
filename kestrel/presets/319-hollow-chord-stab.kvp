format=kestrel-program 1
name=Hollow Chord Stab
category=Dark Stab
author=Kestrel factory
description=Nasal, hollow chord stab: two squares an octave apart through a resonant band-pass, short decay, ping-pong echoes.
t1.osc1.wave=Square
t1.osc2.wave=Square
t1.osc2.semitone=12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-12dB BPF
t1.filter.cutoff=74
t1.filter.resonance=30
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=62
t1.aeg.sustain=0
t1.aeg.release=34
t1.amp.velSense=20
t1.amp.level=80
fx.mod.type=Flanger/Chorus
fx.mod.speed=44
fx.mod.depth=30
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=34
