format=kestrel-program 1
name=Ghost Carillon
category=Dark Bells
author=Kestrel factory
description=Layered bells: an FM bell (timbre 1, left) over a quiet DWGS Bell1 approximation an octave down (timbre 2, right). 2 + 2 voices in Compatibility mode.
prog.voiceMode=Layer
t1.osc1.wave=Sine
t1.osc1.ctrl1=24
t1.osc2.wave=Triangle
t1.osc2.semitone=19
t1.osc2.tune=4
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=104
t1.aeg.attack=0
t1.aeg.decay=100
t1.aeg.sustain=0
t1.aeg.release=90
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=24
t1.amp.level=90
t1.amp.pan=-24
t2.osc1.wave=DWGS
t2.osc1.dwgs=57
t2.pitch.transpose=-12
t2.mixer.osc1=127
t2.filter.type=-12dB LPF
t2.filter.cutoff=90
t2.aeg.attack=0
t2.aeg.decay=104
t2.aeg.sustain=0
t2.aeg.release=90
t2.amp.level=66
t2.amp.pan=24
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=32
