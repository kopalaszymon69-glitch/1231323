format=kestrel-program 1
name=Android Lament
category=Dark Vocoder
author=Kestrel factory
description=Mono robot singer: a square-wave carrier with glide and highly resonant, ringing bands. Sing into AUDIO IN 1 and play a melody one note at a time.
prog.voiceMode=Vocoder
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.osc1.wave=Square
t1.osc1.ctrl1=30
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=40
voc.mixer.osc1=127
voc.mixer.noise=8
voc.filter.formantShift=0
voc.filter.resonance=70
voc.filter.efSense=30
voc.in1.threshold=10
voc.in1.hpfLevel=24
voc.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=24
