format=kestrel-program 1
name=Fallen Reese
category=Angelcore Bass
author=Kestrel factory
description=Dark detuned unison reese for the 'fallen angel' side; slow LFO2 on cutoff and a light phaser.
t1.voice.assign=Unison
t1.voice.unisonDetune=16
t1.voice.trigger=Single
t1.pitch.portamento=25
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=7
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=28
t1.filter.egInt=12
t1.filter.keyTrack=24
t1.feg.attack=2
t1.feg.decay=70
t1.feg.sustain=60
t1.feg.release=40
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=110
t1.aeg.release=30
t1.amp.level=100
t1.lfo2.wave=Sine
t1.lfo2.freq=22
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=10
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Phaser
fx.mod.speed=12
fx.mod.depth=35
