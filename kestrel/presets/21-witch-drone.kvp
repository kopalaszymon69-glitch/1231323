format=kestrel-program 1
name=Witch Drone
category=Witch House Synth
author=Kestrel factory
description=Heavy unison saw drone, dark low-pass with sample&hold flutter and cross delay; play low and hold.
t1.voice.assign=Unison
t1.voice.unisonDetune=38
t1.osc1.wave=Saw
t1.osc1.ctrl1=30
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.mixer.noise=10
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=52
t1.filter.keyTrack=12
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=70
t1.amp.level=74
t1.lfo1.wave=S&H
t1.lfo1.freq=58
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=9
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.time=90
fx.delay.depth=50
fx.mod.type=Phaser
fx.mod.speed=6
fx.mod.depth=40
