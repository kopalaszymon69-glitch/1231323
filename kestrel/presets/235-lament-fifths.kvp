format=kestrel-program 1
name=Lament Fifths
category=Dark Lead
author=Kestrel factory
description=Medieval doubled lead: every note sounds with a square a fourth below it (G under C), like parallel organum. Saw and square, soft filter, glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=24
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-5
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.filter.resonance=14
t1.filter.keyTrack=30
t1.aeg.attack=10
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=50
t1.lfo2.freq=84
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=26
