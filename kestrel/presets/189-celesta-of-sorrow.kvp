format=kestrel-program 1
name=Celesta of Sorrow
category=Dark Bells
author=Kestrel factory
description=Celesta-like bell keys: DWGS Bell4 approximation with a quiet triangle an octave up, medium decay, chorus and a quarter-note echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=60
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=104
t1.aeg.attack=0
t1.aeg.decay=86
t1.aeg.sustain=0
t1.aeg.release=72
t1.amp.velSense=34
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=54
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=28
