format=kestrel-program 1
name=Ashen Sky
category=Dark Pad
author=Kestrel factory
description=Soft cross-modulated sine pad: OSC2 an octave up adds a faint metallic edge that LFO1 slowly brings in and out. Dark 24 dB filter, wide ensemble.
t1.osc1.wave=Sine
t1.osc1.ctrl1=30
t1.osc1.ctrl2=24
t1.lfo1.wave=Triangle
t1.lfo1.freq=24
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-24dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=30
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=98
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=48
fx.mod.depth=90
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=30
