format=kestrel-program 1
name=Dirge Ensemble
category=Dark Strings & Choir
author=Kestrel factory
description=Hollow, reedy string machine: a narrow pulse with gentle PWM from LFO1, a 24 dB low-pass and full ensemble. Darker and thinner than Elegy Strings.
t1.osc1.wave=Square
t1.osc1.ctrl1=40
t1.osc1.ctrl2=24
t1.lfo1.wave=Triangle
t1.lfo1.freq=50
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.filter.resonance=10
t1.filter.keyTrack=24
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=84
t1.amp.level=52
fx.mod.type=Ensemble
fx.mod.speed=58
fx.mod.depth=100
fx.delay.type=Stereo Delay
fx.delay.time=86
fx.delay.depth=20
