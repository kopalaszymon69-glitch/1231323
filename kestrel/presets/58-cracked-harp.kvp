format=kestrel-program 1
name=Cracked Harp
category=Sad Pluck
author=Kestrel factory
description=DWGS Guitar2 approximation with a faint ring-modulated octave (slightly sour); ensemble, quarter echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=50
t1.osc2.wave=Triangle
t1.osc2.mod=Ring
t1.osc2.semitone=12
t1.osc2.tune=3
t1.mixer.osc1=120
t1.mixer.osc2=34
t1.filter.type=-12dB LPF
t1.filter.cutoff=88
t1.filter.keyTrack=20
t1.aeg.attack=0
t1.aeg.decay=82
t1.aeg.sustain=0
t1.aeg.release=70
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.depth=40
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=34
t1.amp.velSense=30
fx.mod.speed=50
