format=kestrel-program 1
name=Dying Star
category=Dark Lead
author=Kestrel factory
description=Unison saw lead (all voices on one note, 20 cents spread) whose filter slowly closes over about five seconds while held. Slow vibrato on the MOD wheel.
t1.voice.assign=Unison
t1.voice.unisonDetune=20
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=24
t1.filter.egInt=14
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=110
t1.feg.sustain=30
t1.feg.release=60
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=56
t1.lfo2.freq=80
t1.amp.level=60
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=34
