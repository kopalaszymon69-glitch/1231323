format=kestrel-program 1
name=Pulse of Regret
category=Dark Bass
author=Kestrel factory
description=Slowly breathing PWM bass (LFO1 on pulse width) in a low 24 dB filter.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Square
t1.osc1.ctrl1=40
t1.osc1.ctrl2=20
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=46
t1.filter.resonance=26
t1.filter.keyTrack=32
t1.aeg.attack=2
t1.aeg.decay=70
t1.aeg.sustain=96
t1.aeg.release=30
t1.amp.level=127
