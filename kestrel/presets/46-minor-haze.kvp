format=kestrel-program 1
name=Minor Haze
category=Dark Pad
author=Kestrel factory
description=Every key is a minor dyad: OSC2 a minor third above (+3 st) and slightly sharp. Dark 24 dB filter, ensemble.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=3
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=20
t1.filter.egInt=6
t1.filter.keyTrack=24
t1.feg.attack=80
t1.feg.decay=80
t1.feg.sustain=50
t1.feg.release=80
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=115
t1.aeg.release=90
t1.amp.level=80
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=40
