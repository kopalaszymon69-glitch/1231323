format=kestrel-program 1
name=Ghost Choir
category=Dark Strings & Choir
author=Kestrel factory
description=Whispered choir: Vox wave mixed with plenty of noise through a band-pass, so the vowels sound breathy and far away. Long cross delay.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=30
t1.mixer.osc1=127
t1.mixer.noise=40
t1.filter.type=-12dB BPF
t1.filter.cutoff=82
t1.filter.resonance=24
t1.filter.keyTrack=24
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=90
fx.delay.type=Cross Delay
fx.delay.time=110
fx.delay.depth=44
