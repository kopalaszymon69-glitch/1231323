format=kestrel-program 1
name=Whisper Chant
category=Dark Vocoder
author=Kestrel factory
description=Whispered vocoder: a noise-heavy carrier with only a little saw, slow follower and long echo.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.aeg.attack=10
t1.aeg.decay=80
t1.aeg.sustain=118
t1.aeg.release=60
voc.mixer.osc1=64
voc.mixer.noise=127
voc.filter.formantShift=0
voc.filter.resonance=0
voc.filter.efSense=34
voc.in1.threshold=16
voc.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=44
fx.mod.type=Ensemble
fx.mod.depth=40
