format=kestrel-program 1
name=Muffled Heart
category=Dark Bass
author=Kestrel factory
description=Heartbeat bass: a sine with a fast downward pitch thump (about 5 semitones over 30 ms) and a short body. Play two notes close together for a heartbeat.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Sine
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=90
t1.feg.attack=0
t1.feg.decay=20
t1.feg.sustain=0
t1.feg.release=10
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=40
t1.aeg.release=30
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=30
t1.amp.level=127
