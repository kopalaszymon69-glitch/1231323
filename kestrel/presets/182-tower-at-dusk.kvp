format=kestrel-program 1
name=Tower at Dusk
category=Dark Bells
author=Kestrel factory
description=Church-tower bell: a brighter FM strike (OSC2 three times the pitch, plus a few cents) that mellows as it decays. Half-note echoes like the square below.
t1.osc1.wave=Sine
t1.osc1.ctrl1=30
t1.osc2.wave=Triangle
t1.osc2.semitone=19
t1.osc2.tune=5
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=0
t1.aeg.decay=104
t1.aeg.sustain=0
t1.aeg.release=96
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=30
t1.amp.velSense=24
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=34
