format=kestrel-program 1
name=Ghost Slap
category=Dark Bass
author=Kestrel factory
description=Muted slap bass (DWGS Bass2 approximation): a snappy, velocity-sensitive low-pass and a short decay into a quiet sustain.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.osc1.wave=DWGS
t1.osc1.dwgs=53
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.egInt=12
t1.filter.keyTrack=30
t1.filter.velSense=20
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=10
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=50
t1.aeg.release=20
t1.amp.velSense=20
t1.amp.level=127
