format=kestrel-program 1
name=Haunted Frequency
category=Dark Drone
author=Kestrel factory
description=Numbers-station drone: a self-oscillating filter excited by faint noise, its pitch stepping at random (LFO1 sample & hold, about once a second) up to an octave either way. Atonal on purpose.
t1.mixer.osc1=0
t1.mixer.noise=10
t1.filter.type=-12dB LPF
t1.filter.cutoff=60
t1.filter.resonance=127
t1.filter.keyTrack=48
t1.aeg.attack=40
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.lfo1.wave=S&H
t1.lfo1.freq=50
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=6
t1.amp.level=80
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=L/R Delay
fx.delay.time=96
fx.delay.depth=40
