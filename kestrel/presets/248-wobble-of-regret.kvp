format=kestrel-program 1
name=Wobble of Regret
category=Dark Bass
author=Kestrel factory
description=Slow, tempo-synced wobble: LFO1 (triangle, one cycle per half note) sweeps the 24 dB filter an octave either way on a saw and square bass. Restarts on every note.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=40
t1.filter.keyTrack=24
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=24
t1.lfo1.wave=Triangle
t1.lfo1.tempoSync=On
t1.lfo1.syncNote=1/2
t1.lfo1.keySync=Timbre
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=6
t1.amp.level=100
