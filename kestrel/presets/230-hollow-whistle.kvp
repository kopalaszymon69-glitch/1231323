format=kestrel-program 1
name=Hollow Whistle
category=Dark Lead
author=Kestrel factory
description=Breathy whistle from OSC1 Noise: its resonant filter is set to the key pitch (CONTROL 1 = 24) with high resonance, so the noise sings the note. Glide and echo.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=36
t1.osc1.wave=Noise
t1.osc1.ctrl1=24
t1.osc1.ctrl2=120
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=110
t1.aeg.attack=24
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=46
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=36
