format=kestrel-program 1
name=Paper Lanterns
category=Sad Pluck
author=Kestrel factory
description=Classic soft saw pluck: two detuned saws through a resonant 12 dB low-pass with a quick EG; chorus and dotted echoes. Velocity opens the filter.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-12dB LPF
t1.filter.cutoff=50
t1.filter.resonance=36
t1.filter.egInt=20
t1.filter.keyTrack=30
t1.filter.velSense=16
t1.feg.attack=0
t1.feg.decay=48
t1.feg.sustain=0
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=0
t1.aeg.release=60
t1.amp.velSense=30
t1.amp.level=120
fx.mod.type=Flanger/Chorus
fx.mod.speed=56
fx.mod.depth=36
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=34
