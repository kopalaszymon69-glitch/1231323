format=kestrel-program 1
name=Chapel of Bones
category=Dark Strings & Choir
author=Kestrel factory
description=Layer choir: a Vox choir (timbre 1, left) and a quiet DWGS Voice4 approximation an octave up (timbre 2, right) that enters later. 2 + 2 voices in Compatibility mode.
prog.voiceMode=Layer
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=56
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=24
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=92
t1.amp.level=100
t1.amp.pan=-28
t2.osc1.wave=DWGS
t2.osc1.dwgs=64
t2.pitch.transpose=12
t2.mixer.osc1=120
t2.filter.type=-12dB LPF
t2.filter.cutoff=80
t2.aeg.attack=90
t2.aeg.decay=80
t2.aeg.sustain=124
t2.aeg.release=100
t2.amp.level=64
t2.amp.pan=28
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=80
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=36
