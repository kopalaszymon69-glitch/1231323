format=kestrel-program 1
name=Siren of Grief
category=Dark Lead
author=Kestrel factory
description=Pulse lead with very long glide (about half a second), so every interval wails. Bend range is an octave. Soft 12 dB filter and half-note echoes.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=76
t1.pitch.bendRange=12
t1.osc1.wave=Square
t1.osc1.ctrl1=40
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=30
t1.aeg.attack=12
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=56
t1.pitch.vibratoInt=8
t1.lfo2.freq=84
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=34
