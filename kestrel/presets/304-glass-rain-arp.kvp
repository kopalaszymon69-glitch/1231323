format=kestrel-program 1
name=Glass Rain Arp
category=Dark Arp
author=Kestrel factory
description=Fast Up arpeggio in sextuplets over three octaves of tiny, brittle FM tines, scattered by an eighth-note L/R delay.
arp.on=On
arp.type=Up
arp.range=3
arp.resolution=1/24
arp.gate=30
arp.tempo=84
arp.keySync=On
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=24
t1.osc2.tune=4
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=110
t1.aeg.attack=0
t1.aeg.decay=44
t1.aeg.sustain=0
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=20
t1.amp.level=120
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=46
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=40
