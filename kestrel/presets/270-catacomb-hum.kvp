format=kestrel-program 1
name=Catacomb Hum
category=Dark Drone
author=Kestrel factory
description=Low resonant hum: unison saws with a little noise into a 24 dB low-pass with high resonance, so a single filter tone rings above the drone. Very slow phaser. Hold a low note.
t1.voice.assign=Unison
t1.voice.unisonDetune=18
t1.osc1.wave=Saw
t1.mixer.osc1=110
t1.mixer.noise=20
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=60
t1.filter.keyTrack=24
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=70
fx.mod.type=Phaser
fx.mod.speed=20
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.time=110
fx.delay.depth=34
