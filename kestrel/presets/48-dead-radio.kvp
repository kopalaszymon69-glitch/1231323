format=kestrel-program 1
name=Dead Radio
category=Dark Pad
author=Kestrel factory
description=Saw pad with a ring-modulated, slightly inharmonic OSC2 whose tune wanders on LFO2 sample & hold; band-pass, phaser.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=7
t1.osc2.tune=9
t1.mixer.osc1=100
t1.mixer.osc2=50
t1.filter.type=-12dB BPF
t1.filter.cutoff=76
t1.filter.resonance=30
t1.filter.keyTrack=20
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=110
t1.aeg.release=86
t1.amp.level=110
t1.lfo2.wave=S&H
t1.lfo2.freq=34
t1.patch1.src=LFO2
t1.patch1.dst=OSC2 Tune
t1.patch1.int=6
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Phaser
fx.mod.speed=14
fx.mod.depth=60
fx.delay.time=90
fx.delay.depth=34
