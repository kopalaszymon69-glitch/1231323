format=kestrel-program 1
name=Funeral Organ
category=Melancholic Keys
author=Kestrel factory
description=Church-style organ: DWGS Organ1 approximation plus a 16-foot square an octave down, with a moderate rotating-speaker style chorus.
t1.osc1.wave=DWGS
t1.osc1.dwgs=40
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=50
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=6
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=34
t1.amp.level=70
fx.mod.type=Flanger/Chorus
fx.mod.speed=84
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=96
fx.delay.depth=20
