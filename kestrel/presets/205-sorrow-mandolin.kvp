format=kestrel-program 1
name=Sorrow Mandolin
category=Sad Pluck
author=Kestrel factory
description=Tremolo-picked mandolin: two saws a few cents apart, a plucky filter and LFO2 at about 9 Hz chopping the level while the note fades.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=60
t1.feg.sustain=30
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=40
t1.aeg.release=50
t1.lfo2.wave=Sine
t1.lfo2.freq=94
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-24
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=86
fx.delay.depth=20
t1.amp.velSense=24
