format=kestrel-program 1
name=Rain Arp
category=Dark Arp
author=Kestrel factory
description=Falling arpeggio (Down, 2 octaves, 1/16) of a dark bell pluck with dotted cross echoes. Hold a minor chord.
arp.on=On
arp.type=Down
arp.range=2
arp.resolution=1/16
arp.gate=30
arp.tempo=92
arp.keySync=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=58
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=-4
t1.mixer.osc1=120
t1.mixer.osc2=40
t1.filter.type=-12dB LPF
t1.filter.cutoff=82
t1.filter.keyTrack=20
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=0
t1.aeg.release=60
t1.amp.level=110
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=50
