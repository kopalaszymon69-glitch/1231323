format=kestrel-program 1
name=Faded Polaroid
category=Sad Pluck
author=Kestrel factory
description=Lo-fi pluck: a pulse with a little noise, a fast 24 dB filter decay, slow tape wow on pitch and rolled-off highs. Dotted echo.
t1.osc1.wave=Square
t1.osc1.ctrl1=50
t1.mixer.osc1=120
t1.mixer.noise=8
t1.filter.type=-24dB LPF
t1.filter.cutoff=54
t1.filter.resonance=14
t1.filter.egInt=16
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=46
t1.feg.sustain=10
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=66
t1.aeg.sustain=0
t1.aeg.release=56
t1.lfo2.wave=Sine
t1.lfo2.freq=38
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3.5
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=30
fx.eq.hiFreq=4.00kHz
fx.eq.hiGain=-6
