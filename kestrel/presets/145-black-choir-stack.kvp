format=kestrel-program 1
name=Black Choir Stack
category=Dark Strings & Choir
author=Kestrel factory
description=Monophonic unison choir: all four voices stacked on one Vox note with 30 cents of spread and a little glide. For slow melodies and held drones.
t1.voice.assign=Unison
t1.voice.unisonDetune=30
t1.voice.trigger=Single
t1.pitch.portamento=40
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=60
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=24
t1.aeg.attack=50
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=80
t1.amp.level=66
fx.mod.type=Ensemble
fx.mod.speed=48
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=30
