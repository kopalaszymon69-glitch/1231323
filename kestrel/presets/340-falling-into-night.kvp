format=kestrel-program 1
name=Falling into Night
category=Dark FX
author=Kestrel factory
description=Long downward sweep: each note starts two octaves high and falls to the played pitch over about three seconds (filter EG to pitch) while the filter closes. Saw plus noise.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=5
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.mixer.noise=20
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=40
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=100
t1.feg.sustain=0
t1.feg.release=60
t1.aeg.attack=10
t1.aeg.decay=100
t1.aeg.sustain=100
t1.aeg.release=80
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=63
t1.amp.level=80
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=40
