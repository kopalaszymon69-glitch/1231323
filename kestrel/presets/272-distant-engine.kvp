format=kestrel-program 1
name=Distant Engine
category=Dark Drone
author=Kestrel factory
description=Rumbling machine drone: a square two octaves down and a saw an octave down, with a fast tremble (LFO2 to Amp at about 7 Hz) under a low filter.
t1.osc1.wave=Square
t1.pitch.transpose=-24
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.mixer.osc1=110
t1.mixer.osc2=80
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.keyTrack=12
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
t1.lfo2.wave=Sine
t1.lfo2.freq=90
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-10
t1.amp.level=66
fx.mod.type=Phaser
fx.mod.speed=24
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=24
