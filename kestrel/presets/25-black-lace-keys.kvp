format=kestrel-program 1
name=Black Lace Keys
category=Darkwave Keys
author=Kestrel factory
description=DWGS E.Piano2 approximation through a dark 12 dB low-pass; velocity opens the filter, LFO2 tremolo, ensemble.
t1.voice.assign=Poly
t1.osc1.wave=DWGS
t1.osc1.dwgs=37
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=20
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.resonance=6
t1.filter.egInt=18
t1.filter.keyTrack=36
t1.feg.attack=0
t1.feg.decay=70
t1.feg.sustain=30
t1.feg.release=50
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=40
t1.aeg.release=56
t1.amp.level=118
t1.patch1.src=Velocity
t1.patch1.dst=Cutoff
t1.patch1.int=24
t1.patch2.src=LFO2
t1.patch2.dst=Amp
t1.patch2.int=-8
t1.lfo2.freq=66
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Ensemble
fx.mod.speed=20
fx.mod.depth=50
fx.delay.depth=18
fx.delay.time=70
