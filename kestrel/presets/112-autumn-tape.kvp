format=kestrel-program 1
name=Autumn Tape
category=Dark Pad
author=Kestrel factory
description=Worn-cassette pad: a slow wow (LFO2 to pitch, a few cents) and a faster flutter (LFO1) on two detuned saws, rolled-off highs, chorus and a dotted echo.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=96
t1.filter.type=-12dB LPF
t1.filter.cutoff=64
t1.filter.resonance=8
t1.filter.keyTrack=24
t1.aeg.attack=56
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=86
t1.lfo2.wave=Sine
t1.lfo2.freq=36
t1.lfo1.wave=Triangle
t1.lfo1.freq=60
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=4
t1.patch2.src=LFO1
t1.patch2.dst=Pitch
t1.patch2.int=2
t1.amp.level=86
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=36
fx.eq.hiFreq=5.00kHz
fx.eq.hiGain=-6
