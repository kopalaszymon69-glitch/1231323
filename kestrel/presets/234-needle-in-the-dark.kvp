format=kestrel-program 1
name=Needle in the Dark
category=Dark Lead
author=Kestrel factory
description=Thin, piercing lead: a narrow pulse through a resonant 12 dB high-pass, so only a cold needle of sound remains. Ping-pong echoes.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.pitch.vibratoInt=6
t1.osc1.wave=Square
t1.osc1.ctrl1=110
t1.mixer.osc1=127
t1.filter.type=-12dB HPF
t1.filter.cutoff=60
t1.filter.resonance=40
t1.filter.keyTrack=48
t1.aeg.attack=4
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=40
t1.lfo2.freq=86
t1.amp.level=110
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=40
fx.eq.hiFreq=7.00kHz
fx.eq.hiGain=-4
