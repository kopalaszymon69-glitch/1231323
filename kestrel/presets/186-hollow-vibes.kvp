format=kestrel-program 1
name=Hollow Vibes
category=Dark Bells
author=Kestrel factory
description=Vibraphone after hours: a sine with a quiet triangle an octave up, motor tremolo at about 5 Hz (LFO2 to Amp), long decay, velocity.
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=24
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=0
t1.aeg.release=72
t1.amp.velSense=36
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-12
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=22
