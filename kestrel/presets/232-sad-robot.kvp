format=kestrel-program 1
name=Sad Robot
category=Dark Lead
author=Kestrel factory
description=Robotic lead: a saw ring-modulated by a square an octave up (in tune, but hollow and metallic) through a 24 dB filter. Glide; MOD wheel vibrato.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.pitch.vibratoInt=8
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=12
t1.mixer.osc1=60
t1.mixer.osc2=110
t1.filter.type=-24dB LPF
t1.filter.cutoff=74
t1.filter.resonance=16
t1.filter.keyTrack=30
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=40
t1.lfo2.freq=85
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=40
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=26
