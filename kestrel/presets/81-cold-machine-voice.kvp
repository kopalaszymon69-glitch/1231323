format=kestrel-program 1
name=Cold Machine Voice
category=Dark Vocoder
author=Kestrel factory
description=Robotic vocoder: saw carrier with noise, formants shifted down one step, consonant HPF, the vocoder distortion and a phaser.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=30
voc.mixer.osc1=127
voc.mixer.noise=20
voc.filter.formantShift=-1
voc.filter.cutoff=0
voc.filter.resonance=30
voc.filter.efSense=20
voc.in1.threshold=10
voc.in1.hpfLevel=30
voc.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=44
fx.mod.depth=40
fx.delay.depth=20
voc.amp.distortion=On
