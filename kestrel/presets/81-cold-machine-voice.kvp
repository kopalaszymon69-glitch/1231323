format=kestrel-program 1
name=Cold Machine Voice
category=Dark Vocoder
author=Kestrel factory
description=Robotic vocoder: saw carrier with noise, formant shift -1 and continuous cutoff down, consonant HPF, phaser.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=30
voc.mixer.osc1=127
voc.mixer.noise=10
voc.filter.formantShift=-1
voc.filter.cutoff=-20
voc.filter.resonance=10
voc.filter.efSense=20
voc.in1.threshold=20
voc.in1.hpfLevel=30
voc.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=16
fx.mod.depth=40
fx.delay.depth=20
