format=kestrel-program 1
name=Haunted Lullaby Arp
category=Dark Arp
author=Kestrel factory
description=Slow Alt2 arpeggio in eighths of a small music box (triangle plus faint double octave). Gentle at 72 BPM, eerie in a horror cue.
arp.on=On
arp.type=Alt2
arp.range=2
arp.resolution=1/8
arp.gate=60
arp.tempo=72
arp.keySync=On
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=24
t1.mixer.osc1=127
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=100
t1.aeg.attack=0
t1.aeg.decay=74
t1.aeg.sustain=0
t1.aeg.release=64
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=48
fx.mod.depth=16
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=40
