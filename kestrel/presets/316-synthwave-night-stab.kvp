format=kestrel-program 1
name=Synthwave Night Stab
category=Dark Stab
author=Kestrel factory
description=Dark synthwave chord stab: a saw with a pulse-width-modulated square an octave down, a quick filter decay, lush chorus and dotted-eighth echoes.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=20
t1.filter.egInt=14
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=56
t1.feg.sustain=20
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=40
t1.aeg.release=40
t1.amp.velSense=20
t1.amp.level=100
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=26
