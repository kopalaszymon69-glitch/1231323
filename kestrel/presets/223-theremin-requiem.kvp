format=kestrel-program 1
name=Theremin Requiem
category=Dark Lead
author=Kestrel factory
description=Eerie sine lead: long glide, a soft attack and a wide constant vibrato (about 19 cents at 5.5 Hz). Long stereo echo.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=64
t1.osc1.wave=Sine
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=110
t1.aeg.attack=40
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=56
t1.lfo2.wave=Sine
t1.lfo2.freq=86
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=6
t1.amp.level=127
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=36
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=24
