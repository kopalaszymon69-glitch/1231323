format=kestrel-program 1
name=Dusty Upright
category=Melancholic Keys
author=Kestrel factory
description=Muted hammered-string keys: a saw with a quiet triangle an octave up, a fast filter EG for the hammer and a long natural decay. Velocity shapes the brightness.
t1.osc1.wave=Saw
t1.osc1.ctrl1=10
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=2
t1.mixer.osc1=127
t1.mixer.osc2=40
t1.mixer.noise=4
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.egInt=12
t1.filter.keyTrack=36
t1.filter.velSense=20
t1.feg.attack=0
t1.feg.decay=60
t1.feg.sustain=20
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.velSense=36
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=66
fx.delay.depth=14
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-4
