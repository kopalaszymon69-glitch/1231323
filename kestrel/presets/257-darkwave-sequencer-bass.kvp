format=kestrel-program 1
name=Darkwave Sequencer Bass
category=Dark Bass
author=Kestrel factory
description=Tight, punchy saw bass for eighth-note sequences: quick filter EG with resonance, short decay, every note retriggered.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.aeg.reset=On
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=44
t1.filter.resonance=30
t1.filter.egInt=18
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.feg.release=16
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=20
t1.aeg.release=16
t1.amp.velSense=20
t1.amp.level=127
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=14
