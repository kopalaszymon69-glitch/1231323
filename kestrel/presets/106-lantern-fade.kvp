format=kestrel-program 1
name=Lantern Fade
category=Dark Pad
author=Kestrel factory
description=Very soft folded-triangle pad: LFO1 slowly folds the wave so the overtones flicker like a flame; faint triangle an octave up; long release.
t1.osc1.wave=Triangle
t1.osc1.ctrl1=30
t1.osc1.ctrl2=40
t1.lfo1.wave=Triangle
t1.lfo1.freq=26
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-12dB LPF
t1.filter.cutoff=72
t1.filter.keyTrack=30
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=104
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=60
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=36
