format=kestrel-program 1
name=Deep Water
category=Dark Pad
author=Kestrel factory
description=Sub-heavy, very dark pad: triangle plus a sine-like triangle an octave down under a 24 dB low-pass at full key tracking; LFO2 slowly swells the level like a heavy swell.
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=120
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.keyTrack=48
t1.aeg.attack=84
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.lfo2.wave=Sine
t1.lfo2.freq=20
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-8
t1.amp.level=100
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=110
fx.delay.depth=30
fx.eq.lowFreq=80Hz
fx.eq.lowGain=2
