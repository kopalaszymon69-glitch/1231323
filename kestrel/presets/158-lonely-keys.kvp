format=kestrel-program 1
name=Lonely Keys
category=Melancholic Keys
author=Kestrel factory
description=Soft sine electric piano: light cross-modulation from OSC2 an octave up gives a tine edge on hard hits (velocity opens the filter). Chorus and quarter echo.
t1.osc1.wave=Sine
t1.osc1.ctrl1=34
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=78
t1.filter.keyTrack=24
t1.filter.velSense=20
t1.aeg.attack=0
t1.aeg.decay=90
t1.aeg.sustain=20
t1.aeg.release=60
t1.amp.velSense=40
t1.amp.level=120
fx.mod.type=Flanger/Chorus
fx.mod.speed=56
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=24
