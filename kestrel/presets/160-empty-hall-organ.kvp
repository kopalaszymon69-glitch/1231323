format=kestrel-program 1
name=Empty Hall Organ
category=Melancholic Keys
author=Kestrel factory
description=Organ heard from the back of an empty hall: DWGS Organ5 approximation through a band-pass, with long, soft L/R echoes.
t1.osc1.wave=DWGS
t1.osc1.dwgs=44
t1.mixer.osc1=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=74
t1.filter.resonance=16
t1.filter.keyTrack=24
t1.aeg.attack=20
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=60
t1.amp.level=88
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=40
fx.delay.type=L/R Delay
fx.delay.time=108
fx.delay.depth=40
