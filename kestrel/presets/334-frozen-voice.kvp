format=kestrel-program 1
name=Frozen Voice
category=Dark Vocoder
author=Kestrel factory
description=Smeared, slow vocoder: a very slow envelope follower (E.F. SENSE 110) blurs the vowels into one another, over a shimmering two-phase saw carrier. Ensemble.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.osc1.ctrl1=30
t1.osc1.ctrl2=40
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=84
voc.mixer.osc1=127
voc.mixer.noise=10
voc.filter.formantShift=0
voc.filter.resonance=30
voc.filter.efSense=110
voc.in1.threshold=8
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=80
fx.delay.type=Stereo Delay
fx.delay.time=104
fx.delay.depth=30
