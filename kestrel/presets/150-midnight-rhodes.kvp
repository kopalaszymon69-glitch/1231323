format=kestrel-program 1
name=Midnight Rhodes
category=Melancholic Keys
author=Kestrel factory
description=Dark electric piano (DWGS E.Piano1 approximation) with a slow stereo auto-pan from LFO2, velocity on level and tone, light chorus.
t1.osc1.wave=DWGS
t1.osc1.dwgs=36
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.keyTrack=24
t1.filter.velSense=18
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=24
t1.aeg.release=60
t1.amp.velSense=36
t1.lfo2.wave=Sine
t1.lfo2.freq=62
t1.patch1.src=LFO2
t1.patch1.dst=Pan
t1.patch1.int=24
t1.amp.level=127
fx.mod.type=Flanger/Chorus
fx.mod.speed=60
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=20
