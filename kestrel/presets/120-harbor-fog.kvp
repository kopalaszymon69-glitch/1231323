format=kestrel-program 1
name=Harbor Fog
category=Dark Pad
author=Kestrel factory
description=Layer: timbre 1 is pitched noise breathing through a slow LFO; timbre 2 is a soft saw pad an octave down. Like a foghorn heard through mist. 2 + 2 voices in Compatibility mode.
prog.voiceMode=Layer
t1.osc1.wave=Noise
t1.osc1.ctrl1=36
t1.osc1.ctrl2=90
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.aeg.attack=90
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=104
t1.lfo2.wave=Sine
t1.lfo2.freq=24
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-14
t1.amp.level=100
t1.amp.pan=-20
t2.osc1.wave=Saw
t2.pitch.transpose=-12
t2.osc2.wave=Saw
t2.osc2.tune=4
t2.mixer.osc1=110
t2.mixer.osc2=90
t2.filter.type=-24dB LPF
t2.filter.cutoff=54
t2.filter.resonance=16
t2.filter.keyTrack=24
t2.aeg.attack=80
t2.aeg.decay=80
t2.aeg.sustain=120
t2.aeg.release=100
t2.amp.level=84
t2.amp.pan=20
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.time=116
fx.delay.depth=36
