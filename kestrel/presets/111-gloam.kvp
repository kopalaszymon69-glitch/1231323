format=kestrel-program 1
name=Gloam
category=Dark Pad
author=Kestrel factory
description=Hollow square pad with a quiet saw a minor seventh above on every key: an unresolved, dusky colour. Keep the voicings sparse.
t1.osc1.wave=Square
t1.osc2.wave=Saw
t1.osc2.semitone=10
t1.mixer.osc1=120
t1.mixer.osc2=36
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=16
t1.filter.keyTrack=30
t1.aeg.attack=78
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=64
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=32
