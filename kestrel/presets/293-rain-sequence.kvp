format=kestrel-program 1
name=Rain Sequence
category=Dark Arp
author=Kestrel factory
description=Random-order sixteenths over two octaves: short FM droplets (amp EG drives the cross-modulation) scattered left and right by an L/R delay.
arp.on=On
arp.type=Random
arp.range=2
arp.resolution=1/16
arp.gate=30
arp.tempo=90
arp.keySync=On
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=104
t1.aeg.attack=0
t1.aeg.decay=46
t1.aeg.sustain=0
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=24
t1.amp.level=127
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=50
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=30
