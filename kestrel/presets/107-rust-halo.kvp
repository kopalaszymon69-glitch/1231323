format=kestrel-program 1
name=Rust Halo
category=Dark Pad
author=Kestrel factory
description=Ring-modulated pad: saw against a square an octave below, which adds a hollow subharmonic and a hard metallic edge while staying in tune. Slow phaser.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=-12
t1.mixer.osc1=100
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=92
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=40
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=84
fx.delay.depth=26
