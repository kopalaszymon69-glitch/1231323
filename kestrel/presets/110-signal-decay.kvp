format=kestrel-program 1
name=Signal Decay
category=Dark Pad
author=Kestrel factory
description=Slow hard-sync pad: LFO1 (about 8 s per cycle) drags the synced OSC2 between roughly a fourth and a minor seventh above, so the overtones creak. Chorus and long echoes.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=8
t1.mixer.osc1=40
t1.mixer.osc2=110
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.filter.resonance=12
t1.filter.keyTrack=24
t1.aeg.attack=72
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=92
t1.lfo1.wave=Triangle
t1.lfo1.freq=17
t1.patch1.src=LFO1
t1.patch1.dst=OSC2 Tune
t1.patch1.int=22
t1.amp.level=90
fx.mod.type=Flanger/Chorus
fx.mod.speed=46
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=106
fx.delay.depth=36
