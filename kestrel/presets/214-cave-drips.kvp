format=kestrel-program 1
name=Cave Drips
category=Sad Pluck
author=Kestrel factory
description=Ringing band-pass drips with very wet ping-pong echoes: a pulse excites a resonant 12 dB band-pass that tracks the keyboard.
t1.osc1.wave=Square
t1.osc1.ctrl1=100
t1.mixer.osc1=127
t1.filter.type=-12dB BPF
t1.filter.cutoff=64
t1.filter.resonance=80
t1.filter.egInt=8
t1.filter.keyTrack=48
t1.feg.attack=0
t1.feg.decay=30
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=44
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.velSense=30
t1.amp.level=54
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=64
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=30
