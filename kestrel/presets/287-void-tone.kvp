format=kestrel-program 1
name=Void Tone
category=Dark Drone
author=Kestrel factory
description=Almost nothing: a deep sine with a slow, wide tremolo (about 4 s per cycle) and a long echo. A minimal bed for the emptiest moments.
t1.osc1.wave=Sine
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=80
t1.aeg.attack=96
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=110
t1.lfo2.wave=Sine
t1.lfo2.freq=27
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-20
t1.amp.level=120
fx.delay.type=Stereo Delay
fx.delay.time=120
fx.delay.depth=30
