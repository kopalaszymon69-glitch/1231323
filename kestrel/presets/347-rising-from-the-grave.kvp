format=kestrel-program 1
name=Rising from the Grave
category=Dark FX
author=Kestrel factory
description=Wind-up effect: each note starts two octaves below and rises to the played pitch over about one and a half seconds (filter EG with negative intensity to pitch). Saw plus noise, resonant filter.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.mixer.noise=14
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=40
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=90
t1.feg.sustain=0
t1.feg.release=40
t1.aeg.attack=10
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=60
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=-63
t1.amp.level=90
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=30
