format=kestrel-program 1
name=Dead Chime
category=Dark Bells
author=Kestrel factory
description=Dull, muted chime (DWGS Bell2 approximation) behind a low-pass, with a long decay and dotted-quarter cross echoes.
t1.osc1.wave=DWGS
t1.osc1.dwgs=58
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=84
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=98
t1.aeg.sustain=0
t1.aeg.release=90
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=34
