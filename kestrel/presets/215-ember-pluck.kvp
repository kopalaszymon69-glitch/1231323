format=kestrel-program 1
name=Ember Pluck
category=Sad Pluck
author=Kestrel factory
description=Gritty, burnt pluck: a saw with a square sub through a fast 24 dB filter into the distortion stage. Short echo.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=46
t1.filter.resonance=34
t1.filter.egInt=18
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=48
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=62
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.distortion=On
t1.amp.level=96
fx.mod.type=Phaser
fx.mod.speed=44
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=20
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-4
