format=kestrel-program 1
name=Cathedral Ghost Tone
category=Dark Drone
author=Kestrel factory
description=A sine and a soft triangle a fifth above that take about eight seconds to fade in and as long to fade out, with deep cross echoes. Play one note and wait.
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=7
t1.mixer.osc1=127
t1.mixer.osc2=60
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.aeg.attack=120
t1.aeg.decay=80
t1.aeg.sustain=127
t1.aeg.release=118
t1.amp.level=120
fx.mod.type=Ensemble
fx.mod.speed=36
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.time=124
fx.delay.depth=56
