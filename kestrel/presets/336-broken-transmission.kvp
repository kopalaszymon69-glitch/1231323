format=kestrel-program 1
name=Broken Transmission
category=Dark Vocoder
author=Kestrel factory
description=Glitching radio voice: LFO1 sample & hold makes the formant bands jump up and down (FC MOD), over a saw-and-noise carrier with a phaser.
prog.voiceMode=Vocoder
t1.osc1.wave=Saw
t1.lfo1.wave=S&H
t1.lfo1.freq=64
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=40
voc.mixer.osc1=127
voc.mixer.noise=30
voc.filter.formantShift=0
voc.filter.resonance=40
voc.fcmod.src=LFO1
voc.fcmod.int=40
voc.filter.efSense=24
voc.in1.threshold=10
voc.in1.hpfLevel=30
voc.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=50
fx.mod.depth=40
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=30
