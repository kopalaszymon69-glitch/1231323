format=kestrel-program 1
name=Static Elegy
category=Dark Drone
author=Kestrel factory
description=Broad unison saw drone (40 cents spread) with noise; the resonant low-pass is nudged a few semitones at random by sample & hold. Long cross delay and a slow phaser. Hold one low note.
t1.voice.assign=Unison
t1.voice.unisonDetune=40
t1.osc1.wave=Saw
t1.osc1.ctrl1=40
t1.mixer.osc1=110
t1.mixer.osc2=0
t1.mixer.noise=30
t1.filter.type=-24dB LPF
t1.filter.cutoff=58
t1.filter.resonance=56
t1.filter.keyTrack=12
t1.aeg.attack=60
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=90
t1.amp.level=76
t1.lfo1.wave=S&H
t1.lfo1.freq=34
t1.patch1.src=LFO1
t1.patch1.dst=Cutoff
t1.patch1.int=2
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Cross Delay
fx.delay.time=118
fx.delay.depth=60
fx.mod.type=Phaser
fx.mod.speed=24
fx.mod.depth=50
