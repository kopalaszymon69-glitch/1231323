format=kestrel-program 1
name=Lullaby for None
category=Dark Arp
author=Kestrel factory
description=Random-order arpeggio of a detuned music-box bell at 1/8 with a long L/R echo; never quite repeats.
arp.on=On
arp.type=Random
arp.range=2
arp.resolution=1/8
arp.gate=50
arp.tempo=76
arp.keySync=On
t1.osc1.wave=DWGS
t1.osc1.dwgs=59
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=-7
t1.mixer.osc1=110
t1.mixer.osc2=40
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.aeg.attack=0
t1.aeg.decay=84
t1.aeg.sustain=0
t1.aeg.release=76
t1.amp.level=110
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=50
