format=kestrel-program 1
name=Wind Through Ruins
category=Dark Drone
author=Kestrel factory
description=Howling wind from noise only: a resonant 12 dB low-pass swept slowly by LFO2 over about an octave and a half each way, while LFO1 drifts the wind across the stereo field. Any key.
t1.mixer.osc1=0
t1.mixer.noise=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=74
t1.filter.resonance=70
t1.aeg.attack=80
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.lfo2.wave=Sine
t1.lfo2.freq=24
t1.patch1.src=LFO2
t1.patch1.dst=Cutoff
t1.patch1.int=9
t1.lfo1.wave=Triangle
t1.lfo1.freq=16
t1.patch2.src=LFO1
t1.patch2.dst=Pan
t1.patch2.int=30
t1.amp.level=80
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.time=116
fx.delay.depth=30
