format=kestrel-program 1
name=Vigil
category=Dark Pad
author=Kestrel factory
description=Hollow open-fifth pad (triangle plus a triangle a fifth above) with a breath of noise, a slow phaser and half-note echoes. No third, so it stays bleak and medieval.
t1.osc1.wave=Triangle
t1.osc2.wave=Triangle
t1.osc2.semitone=7
t1.mixer.osc1=120
t1.mixer.osc2=76
t1.mixer.noise=6
t1.filter.type=-12dB LPF
t1.filter.cutoff=66
t1.filter.resonance=10
t1.filter.keyTrack=30
t1.aeg.attack=76
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=100
t1.amp.level=110
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=36
