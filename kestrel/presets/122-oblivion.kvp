format=kestrel-program 1
name=Oblivion
category=Dark Pad
author=Kestrel factory
description=Huge, slow-evolving pad: shimmering two-phase saw, square sub and a little noise. The filter takes about three seconds to open, LFO2 drifts the pan, and long half-note cross echoes trail it.
t1.osc1.wave=Saw
t1.osc1.ctrl1=30
t1.osc1.ctrl2=64
t1.lfo1.wave=Triangle
t1.lfo1.freq=22
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=50
t1.mixer.noise=8
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=28
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.feg.attack=104
t1.feg.decay=110
t1.feg.sustain=60
t1.feg.release=100
t1.aeg.attack=96
t1.aeg.decay=90
t1.aeg.sustain=124
t1.aeg.release=110
t1.lfo2.wave=Sine
t1.lfo2.freq=18
t1.patch1.src=LFO2
t1.patch1.dst=Pan
t1.patch1.int=20
t1.amp.level=72
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=44
fx.eq.lowFreq=100Hz
fx.eq.lowGain=2
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-4
