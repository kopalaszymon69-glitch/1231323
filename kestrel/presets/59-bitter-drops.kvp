format=kestrel-program 1
name=Bitter Drops
category=Sad Pluck
author=Kestrel factory
description=Narrow pulse through a ringing 12 dB low-pass: water-drop plucks bouncing in an L/R delay.
t1.osc1.wave=Square
t1.osc1.ctrl1=96
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=58
t1.filter.resonance=74
t1.filter.egInt=30
t1.filter.keyTrack=40
t1.feg.decay=36
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=0
t1.aeg.release=46
t1.amp.level=86
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=60
