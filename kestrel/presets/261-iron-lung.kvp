format=kestrel-program 1
name=Iron Lung
category=Dark Bass
author=Kestrel factory
description=Breathing machine bass: a saw and square sub whose level and cutoff rise and fall together on a slow LFO2 (about 2.5 s per breath). For held notes.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=100
t1.mixer.osc2=80
t1.mixer.noise=6
t1.filter.type=-24dB LPF
t1.filter.cutoff=44
t1.filter.resonance=24
t1.filter.keyTrack=24
t1.aeg.attack=2
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=40
t1.lfo2.wave=Sine
t1.lfo2.freq=40
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-10
t1.patch2.src=LFO2
t1.patch2.dst=Cutoff
t1.patch2.int=3
t1.amp.level=100
