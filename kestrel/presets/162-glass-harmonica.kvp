format=kestrel-program 1
name=Glass Harmonica
category=Melancholic Keys
author=Kestrel factory
description=Rubbed-glass tone: a pure sine with a faint triangle an octave up, a soft 50 ms attack and a gentle 3 Hz vibrato from LFO2. Long release.
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=20
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=84
t1.lfo2.wave=Sine
t1.lfo2.freq=76
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=3
t1.amp.velSense=20
t1.amp.level=110
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.time=100
fx.delay.depth=34
