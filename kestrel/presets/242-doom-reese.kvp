format=kestrel-program 1
name=Doom Reese
category=Dark Bass
author=Kestrel factory
description=Slow, heavy reese: unison saws (30 cents spread) plus a second saw about 19 cents sharp (the whole patch is tuned down 12 cents so it centres on the note), under a low 24 dB filter; a slow phaser makes it churn.
t1.voice.assign=Unison
t1.voice.unisonDetune=30
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=6
t1.mixer.osc1=110
t1.mixer.osc2=100
t1.filter.type=-24dB LPF
t1.filter.cutoff=44
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=1
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=30
t1.amp.level=60
fx.mod.type=Phaser
fx.mod.speed=34
fx.mod.depth=40
t1.pitch.tune=-12
