format=kestrel-program 1
name=Shortwave Ghosts
category=Dark Drone
author=Kestrel factory
description=Untuned radio: a hard-synced OSC2 whose tuning jumps randomly (LFO1 sample & hold) through a band-pass, with noise. Squeals and murmurs over a held note.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.mod=Sync
t1.osc2.semitone=12
t1.mixer.osc1=20
t1.mixer.osc2=110
t1.mixer.noise=30
t1.filter.type=-12dB BPF
t1.filter.cutoff=80
t1.filter.resonance=30
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=80
t1.lfo1.wave=S&H
t1.lfo1.freq=52
t1.patch1.src=LFO1
t1.patch1.dst=OSC2 Tune
t1.patch1.int=40
t1.amp.level=90
fx.mod.type=Phaser
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=L/R Delay
fx.delay.time=90
fx.delay.depth=34
