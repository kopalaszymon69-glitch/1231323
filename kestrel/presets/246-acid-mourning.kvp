format=kestrel-program 1
name=Acid Mourning
category=Dark Bass
author=Kestrel factory
description=Dark acid line: a saw through a very resonant 24 dB filter with a snappy EG, legato glide between overlapping notes and velocity accents on the cutoff.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.osc1.wave=Saw
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=40
t1.filter.resonance=90
t1.filter.egInt=22
t1.filter.keyTrack=24
t1.filter.velSense=24
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=0
t1.feg.release=20
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=90
t1.aeg.release=20
t1.amp.level=100
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=20
