format=kestrel-program 1
name=Old Reed Organ
category=Melancholic Keys
author=Kestrel factory
description=Wheezy reed organ: narrow pulse plus a square an octave up, a breath of noise, slight vibrato and a soft swell. Sounds like a village church at dusk.
t1.osc1.wave=Square
t1.osc1.ctrl1=80
t1.osc2.wave=Square
t1.osc2.semitone=12
t1.mixer.osc1=110
t1.mixer.osc2=40
t1.mixer.noise=5
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=24
t1.aeg.attack=14
t1.aeg.decay=64
t1.aeg.sustain=127
t1.aeg.release=40
t1.lfo2.wave=Sine
t1.lfo2.freq=80
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=2.5
t1.amp.level=56
fx.mod.type=Ensemble
fx.mod.speed=46
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=90
fx.delay.depth=16
