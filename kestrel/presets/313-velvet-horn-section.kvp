format=kestrel-program 1
name=Velvet Horn Section
category=Dark Stab
author=Kestrel factory
description=Soft, muted horns: a slow filter swell (about 0.2 s), a gentle constant vibrato and full ensemble. For sombre chord swells.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=8
t1.filter.egInt=12
t1.filter.keyTrack=24
t1.feg.attack=50
t1.feg.decay=70
t1.feg.sustain=70
t1.feg.release=40
t1.aeg.attack=30
t1.aeg.decay=70
t1.aeg.sustain=110
t1.aeg.release=50
t1.lfo2.wave=Sine
t1.lfo2.freq=84
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=2.5
t1.amp.level=76
fx.mod.type=Ensemble
fx.mod.speed=56
fx.mod.depth=70
fx.delay.type=Stereo Delay
fx.delay.time=86
fx.delay.depth=18
