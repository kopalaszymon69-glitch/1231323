format=kestrel-program 1
name=Fog Bank
category=Dark Pad
author=Kestrel factory
description=Cross-modulated sine (OSC2 a ninth above) through a soft low-pass; slow swell and a long, deep echo.
t1.osc1.wave=Sine
t1.osc1.ctrl1=34
t1.osc1.ctrl2=16
t1.lfo1.wave=Triangle
t1.lfo1.freq=18
t1.osc2.wave=Triangle
t1.osc2.semitone=14
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=70
t1.filter.keyTrack=30
t1.aeg.attack=78
t1.aeg.decay=90
t1.aeg.sustain=118
t1.aeg.release=100
t1.amp.level=94
fx.mod.type=Ensemble
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.time=112
fx.delay.depth=58
fx.eq.lowFreq=120Hz
fx.eq.lowGain=-3
