format=kestrel-program 1
name=Requiem Choir
category=Dark Strings & Choir
author=Kestrel factory
description=Vox-wave choir whose vowel slowly morphs (LFO1 on CONTROL 1 through CONTROL 2); faint triangle an octave up; full ensemble and a half-note echo.
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=40
t1.osc1.ctrl2=20
t1.lfo1.wave=Triangle
t1.lfo1.freq=24
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.mixer.osc2=20
t1.filter.type=-12dB LPF
t1.filter.cutoff=78
t1.filter.keyTrack=24
t1.aeg.attack=70
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=92
t1.amp.level=96
fx.mod.type=Ensemble
fx.mod.speed=52
fx.mod.depth=100
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=34
