format=kestrel-program 1
name=Cathedral Vocoder
category=Dark Vocoder
author=Kestrel factory
description=Darker, larger choir: Vox carrier with a two-phase saw edge, formants shifted down one step, resonant bands, long release and deep cross echoes.
prog.voiceMode=Vocoder
t1.osc1.wave=Vox Wave
t1.osc1.ctrl1=40
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=90
voc.mixer.osc1=127
voc.mixer.noise=20
voc.filter.formantShift=-1
voc.filter.resonance=50
voc.filter.efSense=44
voc.in1.threshold=10
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=90
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=40
