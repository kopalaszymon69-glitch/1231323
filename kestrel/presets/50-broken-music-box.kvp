format=kestrel-program 1
name=Broken Music Box
category=Dark Bells
author=Kestrel factory
description=Worn music box: DWGS Bell1 approximation with a triangle octave 13 cents flat and a slight pitch warble; quarter-note echo.
t1.osc1.wave=DWGS
t1.osc1.dwgs=57
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.osc2.tune=-5
t1.mixer.osc1=120
t1.mixer.osc2=50
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.filter.keyTrack=20
t1.aeg.attack=0
t1.aeg.decay=88
t1.aeg.sustain=0
t1.aeg.release=80
t1.amp.level=127
t1.lfo2.wave=Sine
t1.lfo2.freq=50
t1.patch1.src=LFO2
t1.patch1.dst=Pitch
t1.patch1.int=4
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=40
fx.mod.type=Flanger/Chorus
fx.mod.depth=16
fx.mod.speed=50
t1.amp.velSense=30
