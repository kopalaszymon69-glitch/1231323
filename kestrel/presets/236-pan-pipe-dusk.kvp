format=kestrel-program 1
name=Pan Pipe Dusk
category=Dark Lead
author=Kestrel factory
description=Breathy pipe: a triangle with a chiff of noise at each attack (amp EG to noise level) and a quieter steady breath, slow vibrato and a soft low-pass.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.pitch.portamento=12
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.mixer.noise=8
t1.filter.type=-12dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=40
t1.aeg.attack=14
t1.aeg.decay=50
t1.aeg.sustain=100
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=Noise Level
t1.patch1.int=10
t1.lfo2.wave=Sine
t1.lfo2.freq=80
t1.patch2.src=LFO2
t1.patch2.dst=Pitch
t1.patch2.int=3
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=24
fx.delay.type=Stereo Delay
fx.delay.time=96
fx.delay.depth=30
