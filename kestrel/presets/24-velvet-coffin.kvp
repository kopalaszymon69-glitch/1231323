format=kestrel-program 1
name=Velvet Coffin
category=Darkwave Lead
author=Kestrel factory
description=Hard-sync lead: the filter EG sweeps OSC2 tune (virtual patch), MOD wheel adds vibrato, short glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=18
t1.pitch.vibratoInt=10
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.mod=Sync
t1.osc2.semitone=7
t1.mixer.osc1=40
t1.mixer.osc2=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=92
t1.filter.resonance=20
t1.filter.egInt=10
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=72
t1.feg.sustain=20
t1.feg.release=40
t1.aeg.attack=0
t1.aeg.decay=64
t1.aeg.sustain=120
t1.aeg.release=34
t1.amp.level=100
t1.patch1.src=Filter EG
t1.patch1.dst=OSC2 Tune
t1.patch1.int=44
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=32
fx.mod.type=Flanger/Chorus
fx.mod.depth=18
