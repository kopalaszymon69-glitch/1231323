format=kestrel-program 1
name=Dirge Flute
category=Dark Lead
author=Kestrel factory
description=Breathy triangle flute: noise breath, soft low-pass, delayed vibrato on the MOD wheel, glide.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=20
t1.pitch.vibratoInt=8
t1.lfo2.freq=82
t1.osc1.wave=Triangle
t1.mixer.osc1=127
t1.mixer.noise=26
t1.filter.type=-12dB LPF
t1.filter.cutoff=76
t1.filter.keyTrack=40
t1.aeg.attack=30
t1.aeg.decay=64
t1.aeg.sustain=118
t1.aeg.release=40
t1.amp.level=118
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=36
fx.mod.type=Ensemble
fx.mod.depth=30
fx.mod.speed=46
