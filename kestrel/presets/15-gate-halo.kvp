format=kestrel-program 1
name=Gate Halo
category=Angelcore Bass
author=Kestrel factory
description=Stuttered sub: DWGS SynBass3 approximation with a square sub, gated by tempo-synced LFO2 Square(+) on AMP.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=45
t1.osc1.wave=DWGS
t1.osc1.dwgs=10
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=60
t1.filter.type=-24dB LPF
t1.filter.cutoff=60
t1.filter.resonance=15
t1.filter.keyTrack=48
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=110
t1.aeg.release=30
t1.amp.level=127
t1.lfo2.wave=Square2
t1.lfo2.tempoSync=On
t1.lfo2.syncNote=1/16
t1.lfo2.keySync=Timbre
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-40
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
arp.tempo=122
