format=kestrel-program 1
name=Pulse of the Damned
category=Dark Arp
author=Kestrel factory
description=Trigger-mode sixteenths: the held chord strikes as a hollow ring-modulated bell (square a fifth up, products an octave below), relentlessly. Phaser and echo.
arp.on=On
arp.type=Trigger
arp.resolution=1/16
arp.gate=50
arp.tempo=96
arp.keySync=On
t1.osc1.wave=Triangle
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=7
t1.mixer.osc1=60
t1.mixer.osc2=110
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=50
t1.aeg.sustain=0
t1.aeg.release=36
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=36
fx.mod.depth=40
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=24
