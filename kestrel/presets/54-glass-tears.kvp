format=kestrel-program 1
name=Glass Tears
category=Melancholic Keys
author=Kestrel factory
description=FM-like glassy bell: sine cross-modulated by OSC2 a ninth-plus-octave above; long decay, L/R echoes.
t1.osc1.wave=Sine
t1.osc1.ctrl1=40
t1.osc2.wave=Triangle
t1.osc2.semitone=19
t1.mixer.osc1=127
t1.mixer.osc2=0
t1.filter.type=-12dB LPF
t1.filter.cutoff=108
t1.aeg.attack=0
t1.aeg.decay=96
t1.aeg.sustain=0
t1.aeg.release=84
t1.amp.level=118
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=50
fx.eq.hiFreq=9.00kHz
fx.eq.hiGain=-2
