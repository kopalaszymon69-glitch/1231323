format=kestrel-program 1
name=Tremolo Dread
category=Dark Strings & Choir
author=Kestrel factory
description=Tense horror-film tremolo strings: LFO2 at about 7 Hz chops the level (patch to Amp) on a dark saw ensemble. Best in the low register.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=3
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=62
t1.filter.resonance=10
t1.filter.keyTrack=24
t1.aeg.attack=30
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=64
t1.lfo2.wave=Sine
t1.lfo2.freq=90
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-20
t1.amp.level=54
fx.mod.type=Ensemble
fx.mod.speed=58
fx.mod.depth=60
fx.delay.type=Stereo Delay
fx.delay.time=70
fx.delay.depth=18
