format=kestrel-program 1
name=Rain on Glass
category=Sad Pluck
author=Kestrel factory
description=Tiny high plucks: an FM sine whose brightness follows the short amp envelope, bouncing left and right in eighth-note echoes. Play in the upper octaves.
t1.osc1.wave=Sine
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=110
t1.aeg.attack=0
t1.aeg.decay=42
t1.aeg.sustain=0
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=26
t1.amp.velSense=20
t1.amp.level=127
fx.delay.type=L/R Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=54
fx.mod.type=Ensemble
fx.mod.speed=54
fx.mod.depth=30
