format=kestrel-program 1
name=Iron Bell Tolls
category=Dark Bells
author=Kestrel factory
description=Heavy iron bell an octave down (DWGS Bell3 approximation): a dark strike, a decay of several seconds and half-note echoes.
t1.osc1.wave=DWGS
t1.osc1.dwgs=59
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=88
t1.aeg.attack=0
t1.aeg.decay=110
t1.aeg.sustain=0
t1.aeg.release=100
t1.amp.velSense=20
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=36
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/2
fx.delay.depth=36
