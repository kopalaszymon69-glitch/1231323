format=kestrel-program 1
name=Mourning Marimba
category=Dark Bells
author=Kestrel factory
description=Soft, dark wooden mallet: a triangle with a hint of fold, a fast-closing 24 dB filter and a short decay. Velocity on level and tone.
t1.osc1.wave=Triangle
t1.osc1.ctrl1=10
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=70
t1.filter.egInt=10
t1.filter.keyTrack=40
t1.filter.velSense=16
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=62
t1.aeg.sustain=0
t1.aeg.release=44
t1.amp.velSense=30
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=20
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=24
