format=kestrel-program 1
name=Nimbus Fold
category=Angelcore Bass
author=Kestrel factory
description=Airy folded-triangle mid bass; LFO1 moves the fold, the MOD wheel brightens it. Chorus on top.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=32
t1.osc1.wave=Triangle
t1.osc1.ctrl1=28
t1.osc1.ctrl2=14
t1.lfo1.wave=Triangle
t1.lfo1.freq=38
t1.osc2.wave=Triangle
t1.osc2.semitone=-12
t1.mixer.osc1=105
t1.mixer.osc2=85
t1.filter.type=-12dB LPF
t1.filter.cutoff=82
t1.filter.resonance=18
t1.filter.keyTrack=48
t1.aeg.attack=4
t1.aeg.decay=80
t1.aeg.sustain=96
t1.aeg.release=50
t1.amp.level=110
t1.patch1.src=Mod Wheel
t1.patch1.dst=OSC1 Ctrl1
t1.patch1.int=40
t1.patch2.int=0
t1.patch3.int=0
t1.patch4.int=0
fx.mod.type=Flanger/Chorus
fx.mod.speed=10
fx.mod.depth=22
fx.eq.hiFreq=6.00kHz
fx.eq.hiGain=-3
