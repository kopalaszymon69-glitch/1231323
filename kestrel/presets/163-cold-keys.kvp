format=kestrel-program 1
name=Cold Keys
category=Melancholic Keys
author=Kestrel factory
description=Coldwave poly keys: a hollow square with a quiet saw an octave up, a resonant 24 dB low-pass that snaps shut, velocity on tone. Chorus.
t1.osc1.wave=Square
t1.osc2.wave=Saw
t1.osc2.semitone=12
t1.mixer.osc1=120
t1.mixer.osc2=30
t1.filter.type=-24dB LPF
t1.filter.cutoff=56
t1.filter.resonance=24
t1.filter.egInt=14
t1.filter.keyTrack=30
t1.filter.velSense=18
t1.feg.attack=0
t1.feg.decay=56
t1.feg.sustain=24
t1.feg.release=36
t1.aeg.attack=0
t1.aeg.decay=80
t1.aeg.sustain=70
t1.aeg.release=40
t1.amp.velSense=30
t1.amp.level=90
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/8
fx.delay.depth=18
