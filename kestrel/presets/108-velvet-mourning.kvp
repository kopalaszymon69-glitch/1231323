format=kestrel-program 1
name=Velvet Mourning
category=Dark Pad
author=Kestrel factory
description=Thick, closed pad: a two-phase saw (CONTROL 1 at 64 adds octave weight) over a saw an octave down. Resonant 24 dB low-pass, half key tracking, deep ensemble.
t1.osc1.wave=Saw
t1.osc1.ctrl1=64
t1.osc2.wave=Saw
t1.osc2.semitone=-12
t1.osc2.tune=-4
t1.mixer.osc1=110
t1.mixer.osc2=64
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=36
t1.filter.egInt=6
t1.filter.keyTrack=24
t1.feg.attack=64
t1.feg.decay=90
t1.feg.sustain=64
t1.feg.release=80
t1.aeg.attack=64
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=90
t1.amp.level=90
fx.mod.type=Ensemble
fx.mod.speed=52
fx.mod.depth=90
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=30
