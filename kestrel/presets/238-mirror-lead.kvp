format=kestrel-program 1
name=Mirror Lead
category=Dark Lead
author=Kestrel factory
description=Slowly evolving FM lead: LFO1 (about 4 s per cycle) moves the cross-modulation depth of a sine by OSC2 an octave up, so the tone glints and dulls as you hold it.
t1.voice.assign=Mono
t1.voice.trigger=Single
t1.pitch.portamento=30
t1.pitch.vibratoInt=8
t1.osc1.wave=Sine
t1.osc1.ctrl1=40
t1.osc1.ctrl2=30
t1.lfo1.wave=Triangle
t1.lfo1.freq=30
t1.osc2.wave=Triangle
t1.osc2.semitone=12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=96
t1.aeg.attack=10
t1.aeg.decay=64
t1.aeg.sustain=124
t1.aeg.release=50
t1.lfo2.freq=85
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=44
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/8
fx.delay.depth=32
