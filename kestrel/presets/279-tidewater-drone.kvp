format=kestrel-program 1
name=Tidewater Drone
category=Dark Drone
author=Kestrel factory
description=Layer: surf-like filtered noise that swells and recedes (timbre 1) over a sine-and-triangle sub drone (timbre 2). 2 + 2 voices in Compatibility mode.
prog.voiceMode=Layer
t1.osc1.wave=Noise
t1.osc1.ctrl1=60
t1.osc1.ctrl2=20
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=90
t1.aeg.attack=84
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=104
t1.lfo2.wave=Sine
t1.lfo2.freq=18
t1.patch1.src=LFO2
t1.patch1.dst=Amp
t1.patch1.int=-20
t1.patch2.src=LFO2
t1.patch2.dst=Cutoff
t1.patch2.int=6
t1.amp.level=90
t2.osc1.wave=Sine
t2.osc2.wave=Triangle
t2.osc2.semitone=-12
t2.mixer.osc1=110
t2.mixer.osc2=80
t2.filter.type=-24dB LPF
t2.filter.cutoff=70
t2.aeg.attack=80
t2.aeg.decay=80
t2.aeg.sustain=124
t2.aeg.release=100
t2.amp.level=90
fx.mod.type=Ensemble
fx.mod.speed=40
fx.mod.depth=50
fx.delay.type=Stereo Delay
fx.delay.time=116
fx.delay.depth=26
