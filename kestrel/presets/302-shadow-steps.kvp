format=kestrel-program 1
name=Shadow Steps
category=Dark Arp
author=Kestrel factory
description=Alt1 arpeggio over two octaves with steps 2, 5 and 7 muted: a limping, low pluck pattern for the bass and tenor range.
arp.on=On
arp.type=Alt1
arp.range=2
arp.resolution=1/16
arp.gate=50
arp.tempo=96
arp.keySync=On
arp.step2=Off
arp.step5=Off
arp.step7=Off
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.semitone=-12
t1.mixer.osc1=110
t1.mixer.osc2=70
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=30
t1.filter.egInt=16
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=42
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=10
t1.aeg.release=30
t1.amp.level=127
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=28
