format=kestrel-program 1
name=Bitter Harp
category=Sad Pluck
author=Kestrel factory
description=Plucked harp (DWGS Guitar3 approximation) with a long natural decay, light ensemble and a quarter-note echo. Velocity on level.
t1.osc1.wave=DWGS
t1.osc1.dwgs=51
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=90
t1.filter.keyTrack=20
t1.aeg.attack=0
t1.aeg.decay=92
t1.aeg.sustain=0
t1.aeg.release=72
t1.amp.velSense=34
t1.amp.level=127
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=Stereo Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=26
