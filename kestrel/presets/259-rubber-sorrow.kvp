format=kestrel-program 1
name=Rubber Sorrow
category=Dark Bass
author=Kestrel factory
description=Rubbery bass: a square with a tiny pitch blip at the attack (filter EG to pitch, about 20 cents) and a resonant filter pluck.
t1.voice.assign=Mono
t1.voice.trigger=Multi
t1.feg.reset=On
t1.osc1.wave=Square
t1.mixer.osc1=127
t1.filter.type=-24dB LPF
t1.filter.cutoff=48
t1.filter.resonance=40
t1.filter.egInt=10
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=36
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=70
t1.aeg.sustain=80
t1.aeg.release=20
t1.patch1.src=Filter EG
t1.patch1.dst=Pitch
t1.patch1.int=6
t1.amp.level=127
