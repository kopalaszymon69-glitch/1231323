format=kestrel-program 1
name=Industrial Hit
category=Dark Stab
author=Kestrel factory
description=Clanging metal stab: a saw ring-modulated by a square a tritone up plus a short noise burst (amp EG to noise level), band-passed. Atonal and harsh on purpose.
t1.osc1.wave=Saw
t1.osc2.wave=Square
t1.osc2.mod=Ring
t1.osc2.semitone=6
t1.mixer.osc1=50
t1.mixer.osc2=110
t1.filter.type=-12dB BPF
t1.filter.cutoff=80
t1.filter.resonance=20
t1.filter.keyTrack=24
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=40
t1.patch1.src=Amp EG
t1.patch1.dst=Noise Level
t1.patch1.int=20
t1.amp.level=110
fx.mod.type=Flanger/Chorus
fx.mod.speed=30
fx.mod.depth=40
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=30
