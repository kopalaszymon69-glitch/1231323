format=kestrel-program 1
name=Chord Rain
category=Dark Arp
author=Kestrel factory
description=Trigger-mode arpeggio: the whole held chord is struck again on every eighth note, as a short dark pluck. Hold a minor chord for pulsing rain.
arp.on=On
arp.type=Trigger
arp.resolution=1/8
arp.gate=30
arp.tempo=92
arp.keySync=On
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.tune=4
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=20
t1.filter.egInt=14
t1.filter.keyTrack=24
t1.feg.attack=0
t1.feg.decay=40
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=56
t1.aeg.sustain=0
t1.aeg.release=40
t1.amp.level=90
fx.mod.type=Ensemble
fx.mod.speed=50
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=34
