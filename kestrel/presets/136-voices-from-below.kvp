format=kestrel-program 1
name=Voices from Below
category=Dark Strings & Choir
author=Kestrel factory
description=Deep vocal drone from the DWGS Voice1 approximation, an octave down, with a slow swell and a slowly sweeping phaser.
t1.osc1.wave=DWGS
t1.osc1.dwgs=61
t1.pitch.transpose=-12
t1.mixer.osc1=127
t1.filter.type=-12dB LPF
t1.filter.cutoff=80
t1.filter.keyTrack=24
t1.aeg.attack=84
t1.aeg.decay=80
t1.aeg.sustain=124
t1.aeg.release=96
t1.amp.level=127
fx.mod.type=Phaser
fx.mod.speed=30
fx.mod.depth=50
fx.delay.type=Cross Delay
fx.delay.time=104
fx.delay.depth=34
