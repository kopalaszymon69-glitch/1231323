format=kestrel-program 1
name=Ghost Sermon
category=Witch House Vocoder
author=Kestrel factory
description=Vocoder: saw carrier with a little noise, formant shift -1, slow follower; speak/sing into AUDIO IN 1 (left input) and play chords.
prog.voiceMode=Vocoder
t1.voice.assign=Poly
t1.osc1.wave=Saw
t1.osc1.ctrl1=20
t1.aeg.attack=6
t1.aeg.decay=80
t1.aeg.sustain=120
t1.aeg.release=60
voc.mixer.osc1=127
voc.mixer.noise=14
voc.filter.formantShift=-1
voc.filter.resonance=40
voc.filter.efSense=40
voc.in1.threshold=20
voc.in1.gateSense=40
voc.in1.hpfLevel=30
voc.amp.level=127
fx.mod.type=Ensemble
fx.mod.depth=60
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=1/4
fx.delay.depth=35
