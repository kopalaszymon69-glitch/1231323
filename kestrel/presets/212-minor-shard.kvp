format=kestrel-program 1
name=Minor Shard
category=Sad Pluck
author=Kestrel factory
description=Every key plucks a minor third: OSC2 is a saw three semitones above OSC1. Resonant 24 dB filter snap, dotted echoes. One finger plays a sad melody in thirds.
t1.osc1.wave=Saw
t1.osc2.wave=Saw
t1.osc2.semitone=3
t1.mixer.osc1=110
t1.mixer.osc2=90
t1.filter.type=-24dB LPF
t1.filter.cutoff=50
t1.filter.resonance=30
t1.filter.egInt=18
t1.filter.keyTrack=30
t1.feg.attack=0
t1.feg.decay=50
t1.feg.sustain=0
t1.aeg.attack=0
t1.aeg.decay=66
t1.aeg.sustain=0
t1.aeg.release=56
t1.amp.velSense=30
t1.amp.level=110
fx.mod.type=Flanger/Chorus
fx.mod.speed=50
fx.mod.depth=30
fx.delay.type=Cross Delay
fx.delay.sync=On
fx.delay.syncNote=3/16
fx.delay.depth=36
